---
import Base from './Base.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
}
const { title, description, headings } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
---
<Base title={`Elliott Rosenberg / ${title}`} description={description}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">Elliott Rosenberg</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-here">{title}</span>
  </nav>

  {sections.length > 0 && (
    <nav class="side-nav" aria-label="Sections">
      <ul>
        {sections.map((s) => (
          <li><a href={`#${s.slug}`}>{s.text}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <main class="page">
    <header class="masthead">
      <h1 class="masthead-name">{title}</h1>
      <p class="masthead-role">{description}</p>
    </header>

    <article class="piece">
      <slot />
    </article>
  </main>
</Base>

<style>
  .crumb {
    position: fixed;
    top: 34px;
    left: 40px;
    z-index: 10;
    font-size: 15px;
  }
  .crumb a { text-decoration: none; }
  .crumb-sep { color: var(--faint); margin: 0 4px; }
  .crumb-here { color: var(--faint); }

  /* The sidebar never displaces the column: the column centers identically at
     every width, and the sidebar exists only where it truly fits, fading out
     below that instead of forcing margin jumps. */
  .side-nav {
    position: fixed;
    top: 200px;
    left: 40px;
    max-width: 160px;
    font-size: 15px;
    transition: opacity 200ms ease, visibility 200ms;
  }
  @media (max-width: 1399px) {
    .side-nav { opacity: 0; visibility: hidden; }
  }
  .side-nav a {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .side-nav ul { margin: 0; padding: 0; list-style: none; }
  .side-nav li { margin-bottom: 10px; }
  .side-nav a {
    position: relative;
    color: var(--faint);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .side-nav a::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .side-nav a:hover { color: var(--mid); }
  }
  .side-nav a.active { color: var(--ink); }
  .side-nav a.active::before { opacity: 1; }

  .page {
    max-width: calc(var(--measure) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 150px var(--pad-x) 120px;
  }

  .masthead {
    margin: 0 0 72px calc(-1 * var(--outdent));
    animation: rise 400ms var(--ease-out) backwards;
  }
  .piece { animation: rise 400ms var(--ease-out) 60ms backwards; }
  .masthead-name { margin: 0; font-size: inherit; font-weight: 600; }
  .masthead-role { margin: 0; color: var(--mid); }

  .piece :global(h2) {
    margin: 112px 0 14px calc(-1 * var(--outdent));
    font-size: inherit;
    font-weight: 400;
    color: var(--faint);
  }
  .piece :global(h2:first-child) { margin-top: 0; }
  .piece :global(p) { margin: 0 0 32px; max-width: var(--measure); }
  .piece :global(figure) {
    margin: 56px 0;
    padding: clamp(24px, 4vw, 64px);
    background: var(--surface);
    border-radius: 16px;
  }
  .piece :global(figure img), .piece :global(figure video) { margin: 0 auto; }
  .piece :global(figcaption) {
    margin-top: 16px;
    padding: 0;
    text-align: center;
    font-size: 13px;
    color: var(--mid);
  }

  @media (max-width: 900px) {
    .crumb { position: static; padding: 24px var(--pad-x) 0; }
  }
</style>

<script>
  function initScrollspy() {
    // @ts-ignore
    if (window.__spy) { window.__spy.disconnect(); window.__spy = null; }
    const nav = document.querySelector('.side-nav');
    if (!nav) return;
    const links = [...nav.querySelectorAll('a')] as HTMLAnchorElement[];
    const byId = new Map(
      links
        .map((a) => [decodeURIComponent(a.hash.slice(1)), a] as const)
        .filter(([id]) => document.getElementById(id))
    );
    if (byId.size === 0) return;
    const setActive = (id: string) => {
      links.forEach((a) => a.classList.toggle('active', a === byId.get(id)));
    };
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    byId.forEach((_, id) => spy.observe(document.getElementById(id)!));
    setActive([...byId.keys()][0]);
    // @ts-ignore
    window.__spy = spy;
  }
  initScrollspy();
</script>
