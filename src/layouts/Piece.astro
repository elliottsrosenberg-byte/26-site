---
import Base from './Base.astro';
import MobileNav from '../components/MobileNav.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  ogImage?: string;
}
const { title, description, headings, ogImage } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
---
<Base title={`Elliott Rosenberg / ${title}`} description={description} ogImage={ogImage}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">Elliott Rosenberg</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-here">{title}</span>
  </nav>

  {sections.length > 0 && (
    <nav class="side-nav" aria-label="Sections">
      <ul>
        {sections.map((s) => (
          <li><a href={`#${s.slug}`}>{s.text}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {sections.length > 0 && <MobileNav sections={sections} />}

  <main class="page">
    <header class="masthead">
      <h1 class="masthead-name">{title}</h1>
      <p class="masthead-role">{description}</p>
    </header>

    <article class="piece">
      <slot />
    </article>
  </main>
</Base>

<style>
  .crumb {
    position: fixed;
    top: 34px;
    left: 40px;
    z-index: 10;
    font-size: 15px;
  }
  .crumb a { text-decoration: none; }
  .crumb-sep { color: var(--faint); margin: 0 4px; }
  .crumb-here { color: var(--faint); }

  /* The sidebar never displaces the column: the column centers identically at
     every width, and the sidebar exists only where it truly fits, fading out
     below that instead of forcing margin jumps. */
  .side-nav {
    position: fixed;
    top: 200px;
    left: 32px;
    max-width: 150px;
    font-size: 15px;
    transition: opacity 200ms ease, visibility 200ms;
  }
  @media (max-width: 1119px) {
    .side-nav { opacity: 0; visibility: hidden; }
  }
  .side-nav a {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .side-nav ul { margin: 0; padding: 0; list-style: none; }
  .side-nav li { margin-bottom: 10px; }
  .side-nav a {
    position: relative;
    color: var(--faint);
    text-decoration: none;
    transition: color 150ms ease;
    /* The active dot lives inside the box so the ellipsis clipping below
       can never cut it off; the negative margin keeps text on the axis. */
    padding-left: 12px;
    margin-left: -12px;
  }
  .side-nav a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .side-nav a:hover { color: var(--mid); }
  }
  .side-nav a.active { color: var(--ink); }
  .side-nav a.active::before { opacity: 1; }

  .page {
    /* Reading pages take a narrower measure than home, which also lets the
       sidebar survive to much smaller windows. */
    --measure: 680px;
    max-width: calc(var(--measure) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 150px var(--pad-x) 120px;
  }

  .masthead {
    margin: 0 0 72px calc(-1 * var(--outdent));
    animation: rise 400ms var(--ease-out) backwards;
  }
  .piece { animation: rise 400ms var(--ease-out) 60ms backwards; }
  .masthead-name { margin: 0; font-size: inherit; font-weight: 600; }
  .masthead-role { margin: 0; color: var(--mid); }

  .piece :global(h2) {
    margin: 72px 0 14px calc(-1 * var(--outdent));
    font-size: inherit;
    font-weight: 400;
    color: var(--faint);
  }
  .piece :global(h2:first-child) { margin-top: 0; }
  .piece :global(p) { margin: 0 0 32px; max-width: var(--measure); }
  /* Default media setting, per the Figma project page: the image (the UI)
     sits with rounded corners and a light shadow inside the grey surface
     block; the caption sits BELOW the block, in the case study. */
  /* Media overhangs the column's right edge at twice the header outdent,
     going flush again at the width where the sidebar bows out. */
  .piece :global(figure) { margin: 56px calc(-2 * var(--outdent)) 56px 0; }
  @media (max-width: 1119px) {
    .piece :global(figure) { margin-right: 0; }
  }
  .piece :global(.media-frame) {
    display: block;
    padding: clamp(24px, 4vw, 64px);
    background: var(--surface);
    border-radius: 16px;
  }
  .piece :global(.media-frame img),
  .piece :global(.media-frame video) {
    margin: 0 auto;
    border-radius: 10px;
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.1);
  }
  /* "bare" variant: no surface block, no shadow. */
  .piece :global(figure.bare .media-frame) { padding: 0; background: none; }
  .piece :global(figure.bare img),
  .piece :global(figure.bare video) { box-shadow: none; }
  .piece :global(figcaption) {
    margin-top: 16px;
    padding: 0;
    text-align: center;
    font-size: 13px;
    color: var(--mid);
  }

  /* Callout: markdown blockquote renders as a quiet surface block. */
  .piece :global(blockquote) {
    margin: 40px 0;
    padding: 24px 28px;
    background: var(--surface);
    border-radius: 12px;
    max-width: var(--measure);
  }
  .piece :global(blockquote p) { margin: 0 0 1em; }
  .piece :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Code: chips inline, surface blocks for fenced code. */
  .piece :global(code) {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 2px 7px;
  }
  .piece :global(pre) {
    margin: 40px 0;
    padding: 24px 28px;
    background: var(--surface);
    border-radius: 12px;
    overflow-x: auto;
    max-width: var(--measure);
    font-size: 15px;
    line-height: 1.6;
  }
  .piece :global(pre code) {
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    font-size: inherit;
  }

  @media (max-width: 900px) {
    .crumb { position: static; padding: 20px var(--pad-x) 16px; }
    .page { padding-top: 40px; }
    .masthead { margin-bottom: 48px; }
    .piece :global(h2) { margin-top: 56px; scroll-margin-top: 64px; }
  }
</style>

<script>
  function initScrollspy() {
    // @ts-ignore
    if (window.__spy) { window.__spy.disconnect(); window.__spy = null; }
    const nav = document.querySelector('.side-nav');
    if (!nav) return;
    const links = [...nav.querySelectorAll('a')] as HTMLAnchorElement[];
    const byId = new Map(
      links
        .map((a) => [decodeURIComponent(a.hash.slice(1)), a] as const)
        .filter(([id]) => document.getElementById(id))
    );
    if (byId.size === 0) return;
    const setActive = (id: string) => {
      links.forEach((a) => a.classList.toggle('active', a === byId.get(id)));
    };
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    byId.forEach((_, id) => spy.observe(document.getElementById(id)!));
    setActive([...byId.keys()][0]);
    // @ts-ignore
    window.__spy = spy;
  }
  initScrollspy();

  // Looping media plays only while on screen.
  const vids = document.querySelectorAll<HTMLVideoElement>('.piece video[autoplay]');
  if (vids.length) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
      { threshold: 0.2 }
    );
    vids.forEach((v) => io.observe(v));
  }
</script>
