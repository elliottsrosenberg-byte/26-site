---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Elliott Rosenberg, designer.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GT-America-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GT-America-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var applyTheme = function () {
          try {
            var t = localStorage.getItem('theme');
            var dark = t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.documentElement.dataset.theme = 'dark';
            else delete document.documentElement.dataset.theme;
          } catch (e) {}
        };
        applyTheme();
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('entered')) {
            document.documentElement.classList.add('home-enter');
            sessionStorage.setItem('entered', '1');
          }
        } catch (e) {}
        // Restore a saved AI redesign before first paint, and pin the
        // protection layer above it so the console always survives.
        try {
          var aiCss = localStorage.getItem('ai-css');
          if (aiCss) {
            var fonts = document.createElement('link');
            fonts.id = 'ai-fonts';
            fonts.rel = 'stylesheet';
            fonts.href = 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Space+Mono:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,900;1,400&family=Instrument+Serif:ital@0;1&family=DM+Serif+Display&family=Cormorant+Garamond:wght@400;700&family=IBM+Plex+Mono:wght@400;600&family=VT323&family=Silkscreen:wght@400;700&family=Bungee&family=Archivo+Black&family=Bebas+Neue&family=Caveat:wght@400;700&family=Press+Start+2P&display=swap';
            document.head.appendChild(fonts);
          }
          var aiStyle = document.createElement('style');
          aiStyle.id = 'ai-style';
          if (aiCss) aiStyle.textContent = aiCss;
          document.head.appendChild(aiStyle);
          var protect = document.createElement('style');
          protect.id = 'ai-protect';
          protect.textContent =
            '#ai-console,#console-fab-host{display:block!important;visibility:visible!important;position:fixed!important;margin:0!important;padding:0!important;border:0!important;background:none!important;transform:none!important;animation:none!important;transition:none!important;filter:none!important;opacity:1!important;width:auto!important;height:auto!important;min-height:0!important;max-height:none!important;overflow:visible!important;pointer-events:none!important;inset:auto!important;box-shadow:none!important;}' +
            '#ai-console{left:0!important;right:0!important;bottom:0!important;top:auto!important;z-index:2147483000!important;}' +
            '#console-fab-host{right:36px!important;bottom:32px!important;left:auto!important;top:auto!important;z-index:2147482999!important;}';
          document.head.appendChild(protect);
        } catch (e) {}
        if (!window.__baseBound) {
          window.__baseBound = true;
          document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest && e.target.closest('.theme-toggle');
            if (!btn) return;
            var root = document.documentElement;
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            if (next === 'dark') root.dataset.theme = 'dark';
            else delete root.dataset.theme;
            try { localStorage.setItem('theme', next); } catch (e2) {}
          });
        }
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" transition:persist="theme-toggle">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1 A7 7 0 0 1 8 15 Z" fill="currentColor" />
      </svg>
    </button>

    <slot />

    <div id="console-fab-host">
      <template shadowrootmode="open">
        <style>
          :host { position: fixed; right: 36px; bottom: 32px; z-index: 10; display: block; pointer-events: none; }
          .stack {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
          }
          button {
            pointer-events: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid #e7e5e3;
            border-radius: 10px;
            background: #fbfbfb;
            color: #857f78;
            font-family: 'GT America', -apple-system, 'Helvetica Neue', Arial, sans-serif;
            font-size: 15px;
            cursor: pointer;
            transition: color 150ms ease, transform 150ms ease;
          }
          button:hover { color: #57534e; }
          button:active { transform: scale(0.97); }
          .fab {
            padding: 10px 18px;
            box-shadow: 0 2px 10px rgba(35, 30, 23, 0.08);
            animation: fab-pulse 3.2s ease-in-out infinite;
          }
          @keyframes fab-pulse {
            0%, 100% { box-shadow: 0 2px 10px rgba(35, 30, 23, 0.08); }
            50% { box-shadow: 0 4px 18px rgba(35, 30, 23, 0.16); }
          }
          .to-top {
            display: none;
            width: 40px;
            height: 40px;
            padding: 0;
            box-shadow: 0 2px 10px rgba(35, 30, 23, 0.08);
            opacity: 0;
            transform: translateY(6px);
            visibility: hidden;
            transition: opacity 200ms ease, transform 200ms var(--ease-out, ease), visibility 200ms;
          }
          .to-top.show { opacity: 1; transform: none; visibility: visible; }
          @media (prefers-reduced-motion: reduce) {
            .fab { animation: none; }
            .to-top { transition: none; }
          }
          .fab-code { display: none; }
          :host(.console-open) button { display: none; }
          @media (max-width: 640px) {
            :host { right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); }
            .fab { width: 40px; height: 40px; padding: 0; }
            .fab-label, .fab-chev { display: none; }
            .fab-code { display: block; }
            .to-top { display: inline-flex; }
            :host(.console-open) .to-top,
            :host(.console-open) .fab { display: none; }
          }
        </style>
        <div class="stack">
        <button class="to-top" type="button" aria-label="Back to top">
          <svg width="13" height="13" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2.5 1.8 H9.5 M6 10.2 V4.6 M3.4 7 L6 4.4 L8.6 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button class="fab" type="button" aria-label="Open console">
          <span class="fab-label">Console</span>
          <svg class="fab-chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M2 6.5 L5 3.5 L8 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="fab-code" width="14" height="14" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M3.6 3.4 L1.2 6 L3.6 8.6 M8.4 3.4 L10.8 6 L8.4 8.6 M6.9 2.6 L5.1 9.4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        </div>
      </template>
    </div>

    <section id="ai-console" data-ai-protect aria-label="AI redesign console">
      <template shadowrootmode="open">
        <style>
          :host { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: block; pointer-events: none; }
          .drawer {
            pointer-events: auto;
            position: relative;
            max-height: 60vh;
            max-height: 70dvh;
            overflow-y: auto;
            background: #ffffff;
            color: #1f1c19;
            border-top: 1px solid #e2e0dd;
            font-family: ui-monospace, 'SF Mono', Menlo, monospace;
            font-size: 13.5px;
            line-height: 1.65;
            padding: 14px 24px calc(16px + env(safe-area-inset-bottom, 0px));
            transform: translateY(102%);
            transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1), visibility 260ms;
            visibility: hidden;
          }
          :host(.open) .drawer { transform: none; visibility: visible; }
          @media (prefers-reduced-motion: reduce) { .drawer { transition: none; } }

          .progress {
            position: sticky;
            top: 0;
            z-index: 3;
            display: none;
            height: 2px;
            margin: -14px -24px 12px;
            background: #eeecea;
          }
          .progress b {
            display: block;
            height: 100%;
            width: 0%;
            background: #1d4ed8;
            transition: width 500ms cubic-bezier(0.16, 1, 0.3, 1);
          }
          :host(.running) .progress, :host(.settling) .progress { display: block; }

          .head {
            position: sticky;
            top: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 16px;
            margin: -14px -24px 14px;
            padding: 14px 24px 10px;
            background: #ffffff;
          }
          .title { font-weight: 700; margin-right: auto; }
          .reset, .close {
            border: 1px solid #d5d2ce;
            border-radius: 0;
            background: none;
            color: #6f6a64;
            font: inherit;
            font-size: 12.5px;
            line-height: 1.3;
            padding: 3px 10px;
            cursor: pointer;
          }
          .close { color: #1f1c19; padding: 3px 9px; }
          .reset:hover, .close:hover { background: #f2f0ee; color: #1f1c19; }
          .reset[hidden] { display: none; }

          .intro { margin: 0 0 14px; color: #d9480f; }
          .intro-more { display: none; border: 0; background: none; font: inherit; color: #1d4ed8; padding: 0; margin: -8px 0 14px; cursor: pointer; }
          @media (max-width: 640px) {
            .intro {
              display: -webkit-box;
              -webkit-box-orient: vertical;
              -webkit-line-clamp: 4;
              overflow: hidden;
              margin-bottom: 6px;
            }
            .intro.expanded { display: block; -webkit-line-clamp: none; }
            .intro-more { display: block; }
          }
          .line { margin: 0 0 8px; color: #6f6a64; }
          .theme-line { color: #1f1c19; font-weight: 700; }
          .plan-line, .theme-line { margin: 0 0 4px; }
          .plan-line { color: #6f6a64; }
          .status { margin: 0 0 8px; }
          .status:empty, .theme-line:empty, .plan-line:empty { display: none; }
          :host(.running) .status::after {
            content: '▍';
            margin-left: 2px;
            animation: blink 1s steps(1) infinite;
          }
          @keyframes blink { 50% { opacity: 0; } }

          .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 2px 0 14px; }
          .chip {
            border: 1px solid #c9c5c1;
            border-radius: 0;
            background: none;
            color: #1d4ed8;
            font: inherit;
            font-size: 12.5px;
            padding: 2px 10px;
            cursor: pointer;
          }
          .chip:hover { background: #eef2fd; }

          form { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
          .caret { color: #6f6a64; }
          input {
            flex: 1;
            min-width: 0;
            border: 1px solid #c9c5c1;
            border-radius: 0;
            background: #ffffff;
            color: #1f1c19;
            font: inherit;
            font-size: 16px;
            padding: 7px 12px;
            outline: none;
          }
          input:focus { border-color: #1f1c19; }
          input:disabled { color: #a5a09a; }
          .go {
            border: 0;
            border-radius: 0;
            background: #1d4ed8;
            color: #ffffff;
            font: inherit;
            font-size: 13.5px;
            padding: 8px 16px;
            cursor: pointer;
          }
          .go:disabled { background: #a9b6d9; cursor: default; }
          .count { margin: 8px 0 0; color: #a5a09a; font-size: 12.5px; }
          @media (max-width: 640px) {
            .drawer { padding: 12px 16px calc(14px + env(safe-area-inset-bottom, 0px)); }
            .progress { margin: -12px -16px 12px; }
            .head { margin: -12px -16px 12px; padding: 12px 16px 8px; }
          }
        </style>
        <div class="drawer">
          <div class="progress"><b></b></div>
          <header class="head">
            <span class="title">Console</span>
            <button class="reset" type="button" hidden>reset design</button>
            <button class="close" type="button" aria-label="Close console">×</button>
          </header>
          <p class="intro">After redesigning my website five times over the past five months, each time with a new design tool or AI integration, I decided that I'd always have a new tool or piece of technology to play with. Also, as a designer that works across multiple disciplines, I find that I'm always adjusting my portfolio to cater to different recruiters, thought leaders, or potential investors. As a gesture to the ever-changing nature of the internet, I'll let you design my website for me. If you're looking for a tech site, a fine arts gallery page, or an animation-heavy creative splurge, click the tags below for some examples.</p>
          <button class="intro-more" type="button">// read more</button>
          <p class="line">// this site can be redesigned by AI. describe a visual vibe below to transform it</p>
          <p class="line">// quick start:</p>
          <div class="chips">
            <button type="button" class="chip">B2B SaaS</button>
            <button type="button" class="chip">lo-fi computer</button>
            <button type="button" class="chip">y2k</button>
            <button type="button" class="chip">emo</button>
          </div>
          <p class="theme-line" aria-live="polite"></p>
          <p class="plan-line"></p>
          <p class="status" aria-live="polite"></p>
          <form>
            <span class="caret">&gt;</span>
            <input type="text" placeholder="describe what you want the site to look like..." maxlength="300" autocomplete="off" spellcheck="false" aria-label="Describe a vibe" />
            <button class="go" type="submit">Run</button>
          </form>
          <p class="count">// 0 / 300</p>
        </div>
      </template>
    </section>

    <style>
      .theme-toggle {
        position: fixed;
        top: 28px;
        right: 36px;
        z-index: 10;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: none;
        color: var(--mid);
        cursor: pointer;
        transition: color 150ms ease;
      }
      @media (hover: hover) and (pointer: fine) {
        .theme-toggle:hover { color: var(--ink); }
      }

      @media (max-width: 900px) {
        .theme-toggle { position: absolute; top: 18px; right: 16px; }
      }
    </style>

    <script>
      // ── AI redesign engine ─────────────────────────────────────────────
      // The console and its FAB live in shadow roots, so a redesign's CSS
      // can't reach their internals; the protect layer pins host geometry.
      {
        const fabHost = document.getElementById('console-fab-host');
        const fab = fabHost?.shadowRoot?.querySelector<HTMLButtonElement>('.fab');
        const panel = document.getElementById('ai-console');
        const root = panel?.shadowRoot;
        const form = root?.querySelector('form');
        const input = root?.querySelector('input');
        const go = root?.querySelector<HTMLButtonElement>('.go');
        const status = root?.querySelector<HTMLElement>('.status');
        const themeLine = root?.querySelector<HTMLElement>('.theme-line');
        const planLine = root?.querySelector<HTMLElement>('.plan-line');
        const bar = root?.querySelector<HTMLElement>('.progress b');
        const resetBtn = root?.querySelector<HTMLButtonElement>('.reset');
        const counter = root?.querySelector<HTMLElement>('.count');
        const styleEl = document.getElementById('ai-style') as HTMLStyleElement | null;

        const FONTS_URL = 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Space+Mono:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,900;1,400&family=Instrument+Serif:ital@0;1&family=DM+Serif+Display&family=Cormorant+Garamond:wght@400;700&family=IBM+Plex+Mono:wght@400;600&family=VT323&family=Silkscreen:wght@400;700&family=Bungee&family=Archivo+Black&family=Bebas+Neue&family=Caveat:wght@400;700&family=Press+Start+2P&display=swap';
        const ensureFonts = () => {
          if (!document.getElementById('ai-fonts')) {
            const link = document.createElement('link');
            link.id = 'ai-fonts';
            link.rel = 'stylesheet';
            link.href = FONTS_URL;
            document.head.appendChild(link);
          }
        };

        if (fabHost && fab && panel && root && form && input && go && status && themeLine && planLine && bar && resetBtn && counter && styleEl) {
          input.addEventListener('input', () => {
            counter.textContent = `// ${input.value.length} / 300`;
          });
          let running = false;

          const setStatus = (t: string) => { status.textContent = t; };
          const syncState = () => {
            const vibe = localStorage.getItem('ai-vibe');
            resetBtn.hidden = !vibe && !running;
            if (vibe && !running) setStatus(`// ${vibe}`);
          };

          const openPanel = () => {
            panel.classList.add('open');
            fabHost.classList.add('console-open');
            syncState();
            // On touch screens focusing would raise the keyboard and scroll
            // the drawer; let the visitor tap the field themselves.
            if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
              setTimeout(() => input.focus(), 220);
            }
          };
          const closePanel = () => {
            panel.classList.remove('open');
            fabHost.classList.remove('console-open');
          };

          fab.addEventListener('click', openPanel);
          const toTop = fabHost.shadowRoot?.querySelector<HTMLButtonElement>('.to-top');
          if (toTop) {
            const onScroll = () => toTop.classList.toggle('show', scrollY >= innerHeight * 1.5);
            addEventListener('scroll', onScroll, { passive: true });
            onScroll();
            toTop.addEventListener('click', () => {
              const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
              scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
            });
          }
          root.querySelector('.close')?.addEventListener('click', closePanel);
          const intro = root.querySelector<HTMLElement>('.intro');
          const more = root.querySelector<HTMLButtonElement>('.intro-more');
          if (intro && more) {
            more.addEventListener('click', () => {
              const expanded = intro.classList.toggle('expanded');
              more.textContent = expanded ? '// read less' : '// read more';
            });
          }
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && panel.classList.contains('open')) closePanel();
          });

          root.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
            chip.addEventListener('click', () => {
              input.value = chip.textContent ?? '';
              form.requestSubmit();
            });
          });

          // Streams open with THEME / PLAN comments, then CSS. Typical full
          // output lands near 12kb; the bar eases toward that and holds at
          // 96% until the stream actually closes.
          const TARGET_BYTES = 12 * 1024;
          const HEAD_RE = /\/\*\s*(THEME|PLAN):\s*([\s\S]*?)\*\//g;

          const run = async (vibe: string) => {
            if (running) return;
            running = true;
            ensureFonts();
            panel.classList.add('running');
            panel.classList.remove('settling');
            input.disabled = true;
            go.disabled = true;
            resetBtn.hidden = true;
            themeLine.textContent = '';
            planLine.textContent = '';
            bar.style.width = '4%';
            setStatus('// planning…');
            let css = '';
            try {
              const res = await fetch('/api/redesign', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vibe }),
              });
              if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);
              const reader = res.body.getReader();
              const decoder = new TextDecoder();
              while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                css += decoder.decode(value, { stream: true });
                styleEl.textContent = css.replace(/^```(?:css)?/i, '');
                HEAD_RE.lastIndex = 0;
                let m;
                while ((m = HEAD_RE.exec(css))) {
                  const text = m[2].trim().replace(/\s+/g, ' ');
                  if (m[1] === 'THEME') themeLine.textContent = `// theme: ${text}`;
                  else planLine.textContent = `// plan: ${text}`;
                }
                const pct = Math.min(96, 4 + (css.length / TARGET_BYTES) * 92);
                bar.style.width = `${pct}%`;
                setStatus(`// designing… ${(css.length / 1024).toFixed(1)}kb`);
              }
              css = css.replace(/^```(?:css)?/i, '').replace(/```\s*$/, '');
              styleEl.textContent = css;
              localStorage.setItem('ai-css', css);
              localStorage.setItem('ai-vibe', vibe);
              bar.style.width = '100%';
              setStatus(`// done · ${(css.length / 1024).toFixed(1)}kb · ${vibe}`);
              panel.classList.add('settling');
              setTimeout(() => panel.classList.remove('settling'), 1200);
            } catch (err) {
              setStatus('// something broke. try again.');
              console.error('redesign failed:', err);
            } finally {
              running = false;
              panel.classList.remove('running');
              input.disabled = false;
              go.disabled = false;
              resetBtn.hidden = !localStorage.getItem('ai-vibe');
            }
          };

          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const vibe = input.value.trim();
            if (vibe) run(vibe);
          });

          resetBtn.addEventListener('click', () => {
            styleEl.textContent = '';
            localStorage.removeItem('ai-css');
            localStorage.removeItem('ai-vibe');
            input.value = '';
            counter.textContent = '// 0 / 300';
            themeLine.textContent = '';
            planLine.textContent = '';
            setStatus('');
            syncState();
          });

          syncState();
        }
      }
    </script>
  </body>
</html>
