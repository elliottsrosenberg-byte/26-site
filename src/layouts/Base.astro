---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Elliott Rosenberg, designer.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GT-America-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GT-America-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var applyTheme = function () {
          try {
            var t = localStorage.getItem('theme');
            var dark = t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.documentElement.dataset.theme = 'dark';
            else delete document.documentElement.dataset.theme;
          } catch (e) {}
        };
        applyTheme();
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('entered')) {
            document.documentElement.classList.add('home-enter');
            sessionStorage.setItem('entered', '1');
          }
        } catch (e) {}
        // Restore a saved AI redesign before first paint, and pin the
        // protection layer above it so the console always survives.
        try {
          var aiCss = localStorage.getItem('ai-css');
          if (aiCss) {
            var fonts = document.createElement('link');
            fonts.id = 'ai-fonts';
            fonts.rel = 'stylesheet';
            fonts.href = 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Space+Mono:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,900;1,400&family=Instrument+Serif:ital@0;1&family=DM+Serif+Display&family=Cormorant+Garamond:wght@400;700&family=IBM+Plex+Mono:wght@400;600&family=VT323&family=Silkscreen:wght@400;700&family=Bungee&family=Archivo+Black&family=Bebas+Neue&family=Caveat:wght@400;700&family=Press+Start+2P&display=swap';
            document.head.appendChild(fonts);
          }
          var aiStyle = document.createElement('style');
          aiStyle.id = 'ai-style';
          if (aiCss) aiStyle.textContent = aiCss;
          document.head.appendChild(aiStyle);
          var protect = document.createElement('style');
          protect.id = 'ai-protect';
          protect.textContent =
            '[data-ai-protect] *{animation:none!important;filter:none!important;text-shadow:none!important;letter-spacing:normal!important;text-transform:none!important;}' +
            '#ai-console{position:fixed!important;left:0!important;right:0!important;bottom:0!important;top:auto!important;background:#ffffff!important;color:#1f1c19!important;border-top:1px solid #e2e0dd!important;}' +
            '.console-fab{position:fixed!important;right:36px!important;bottom:32px!important;background:#fbfbfb!important;color:#857f78!important;border:1px solid #e7e5e3!important;border-radius:10px!important;}';
          document.head.appendChild(protect);
        } catch (e) {}
        if (!window.__baseBound) {
          window.__baseBound = true;
          document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest && e.target.closest('.theme-toggle');
            if (!btn) return;
            var root = document.documentElement;
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            if (next === 'dark') root.dataset.theme = 'dark';
            else delete root.dataset.theme;
            try { localStorage.setItem('theme', next); } catch (e2) {}
          });
        }
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" transition:persist="theme-toggle">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1 A7 7 0 0 1 8 15 Z" fill="currentColor" />
      </svg>
    </button>

    <slot />

    <button class="console-fab" type="button" aria-label="Open console" data-ai-protect>
      Console
      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2 6.5 L5 3.5 L8 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <section class="console" id="ai-console" data-ai-protect aria-label="AI redesign console">
      <header class="console-head">
        <span class="console-title">Console</span>
        <button class="console-reset" type="button" hidden>reset design</button>
        <button class="console-close" type="button" aria-label="Close console">×</button>
      </header>
      <p class="console-intro">After redesigning my website five times over the past five months, each time with a new design tool or AI integration, I decided that I'd always have a new tool or piece of technology to play with. Also, as a designer that works across multiple disciplines, I find that I'm always adjusting my portfolio to cater to different recruiters, thought leaders, or potential investors. As a gesture to the ever-changing nature of the internet, I'll let you design my website for me. If you're looking for a tech site, a fine arts gallery page, or an animation-heavy creative splurge, click the tags below for some examples.</p>
      <p class="console-line">// this site can be redesigned by AI. describe a visual vibe below to transform it</p>
      <p class="console-line">// quick start:</p>
      <div class="console-chips">
        <button type="button" class="console-chip">B2B SaaS</button>
        <button type="button" class="console-chip">lo-fi computer</button>
        <button type="button" class="console-chip">y2k</button>
        <button type="button" class="console-chip">emo</button>
      </div>
      <p class="console-line console-status" aria-live="polite"></p>
      <form class="console-form">
        <span class="console-caret" aria-hidden="true">&gt;</span>
        <input class="console-input" type="text" placeholder="describe what you want the site to look like..." maxlength="300" autocomplete="off" spellcheck="false" aria-label="Describe a vibe" />
        <button class="console-go" type="submit">Run</button>
      </form>
      <p class="console-count">// 0 / 300</p>
    </section>

    <style>
      .theme-toggle {
        position: fixed;
        top: 28px;
        right: 36px;
        z-index: 10;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: none;
        color: var(--mid);
        cursor: pointer;
        transition: color 150ms ease;
      }
      @media (hover: hover) and (pointer: fine) {
        .theme-toggle:hover { color: var(--ink); }
      }

      .console-fab {
        position: fixed;
        right: 36px;
        bottom: 32px;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border: 1px solid var(--hairline);
        border-radius: 10px;
        background: var(--bg);
        color: var(--faint);
        font: inherit;
        font-size: 15px;
        cursor: pointer;
        transition: color 150ms ease, transform 150ms var(--ease-out);
      }
      @media (hover: hover) and (pointer: fine) {
        .console-fab:hover { color: var(--mid); }
      }
      .console-fab:active { transform: scale(0.97); }

      /* ── AI redesign console: the original terminal drawer. Hardcoded
            colors on purpose: it keeps its identity under any redesign. ── */
      .console {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 20;
        max-height: 60vh;
        overflow-y: auto;
        background: #ffffff;
        color: #1f1c19;
        border-top: 1px solid #e2e0dd;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 13.5px;
        line-height: 1.65;
        padding: 14px 24px 14px;
        transform: translateY(102%);
        transition: transform 260ms var(--ease-out), visibility 260ms;
        visibility: hidden;
      }
      .console.open { transform: none; visibility: visible; }

      .console-head { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
      .console-title { font-weight: 700; margin-right: auto; }
      .console-close {
        border: 1px solid #d5d2ce;
        border-radius: 4px;
        background: none;
        color: #1f1c19;
        font: inherit;
        line-height: 1;
        padding: 3px 9px;
        cursor: pointer;
      }
      .console-close:hover { background: #f2f0ee; }
      .console-reset {
        border: 1px solid #d5d2ce;
        border-radius: 4px;
        background: none;
        color: #6f6a64;
        font: inherit;
        font-size: 12.5px;
        padding: 3px 10px;
        cursor: pointer;
      }
      .console-reset:hover { color: #1f1c19; background: #f2f0ee; }

      .console-intro { margin: 0 0 14px; color: #d9480f; max-width: 1200px; }
      .console-line { margin: 0 0 8px; color: #6f6a64; }
      .console-status:empty { display: none; }
      .console.running .console-status::after {
        content: '▍';
        margin-left: 2px;
        animation: console-blink 1s steps(1) infinite;
      }
      @keyframes console-blink { 50% { opacity: 0; } }

      .console-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 2px 0 14px; }
      .console-chip {
        border: 1px solid #c9c5c1;
        border-radius: 4px;
        background: none;
        color: #1d4ed8;
        font: inherit;
        font-size: 12.5px;
        padding: 2px 10px;
        cursor: pointer;
      }
      .console-chip:hover { background: #eef2fd; }

      .console-form { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
      .console-caret { color: #6f6a64; }
      .console-input {
        flex: 1;
        min-width: 0;
        border: 1px solid #c9c5c1;
        border-radius: 4px;
        background: #ffffff;
        color: #1f1c19;
        font: inherit;
        font-size: 16px;
        padding: 7px 12px;
        outline: none;
      }
      .console-input:focus { border-color: #1f1c19; }
      .console-input:disabled { color: #a5a09a; }
      .console-go {
        border: 0;
        border-radius: 4px;
        background: #1d4ed8;
        color: #ffffff;
        font: inherit;
        font-size: 13.5px;
        padding: 8px 16px;
        cursor: pointer;
      }
      .console-go:disabled { background: #a9b6d9; cursor: default; }
      .console-count { margin: 8px 0 0; color: #a5a09a; font-size: 12.5px; }

      @media (max-width: 640px) {
        .theme-toggle { top: 16px; right: 16px; }
        .console-fab { right: 16px; bottom: 16px; }
        .console { padding: 12px 16px; }
      }
    </style>

    <script>
      // ── AI redesign engine ─────────────────────────────────────────────
      {
        const fab = document.querySelector<HTMLButtonElement>('.console-fab');
        const panel = document.getElementById('ai-console');
        const form = panel?.querySelector<HTMLFormElement>('.console-form');
        const input = panel?.querySelector<HTMLInputElement>('.console-input');
        const go = panel?.querySelector<HTMLButtonElement>('.console-go');
        const status = panel?.querySelector<HTMLElement>('.console-status');
        const resetBtn = panel?.querySelector<HTMLButtonElement>('.console-reset');
        const counter = panel?.querySelector<HTMLElement>('.console-count');
        const styleEl = document.getElementById('ai-style') as HTMLStyleElement | null;

        const FONTS_URL = 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=Space+Mono:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,900;1,400&family=Instrument+Serif:ital@0;1&family=DM+Serif+Display&family=Cormorant+Garamond:wght@400;700&family=IBM+Plex+Mono:wght@400;600&family=VT323&family=Silkscreen:wght@400;700&family=Bungee&family=Archivo+Black&family=Bebas+Neue&family=Caveat:wght@400;700&family=Press+Start+2P&display=swap';
        const ensureFonts = () => {
          if (!document.getElementById('ai-fonts')) {
            const link = document.createElement('link');
            link.id = 'ai-fonts';
            link.rel = 'stylesheet';
            link.href = FONTS_URL;
            document.head.appendChild(link);
          }
        };

        if (fab && panel && form && input && go && status && resetBtn && counter && styleEl) {
          input.addEventListener('input', () => {
            counter.textContent = `// ${input.value.length} / 300`;
          });
          let running = false;

          const setStatus = (t: string) => { status.textContent = t; };
          const syncState = () => {
            const vibe = localStorage.getItem('ai-vibe');
            resetBtn.hidden = !vibe && !running;
            if (vibe && !running) setStatus(`// ${vibe}`);
          };

          const openPanel = () => {
            panel.classList.add('open');
            fab.hidden = true;
            syncState();
            setTimeout(() => input.focus(), 220);
          };
          const closePanel = () => {
            panel.classList.remove('open');
            fab.hidden = false;
          };

          fab.addEventListener('click', openPanel);
          panel.querySelector('.console-close')?.addEventListener('click', closePanel);
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && panel.classList.contains('open')) closePanel();
          });

          panel.querySelectorAll<HTMLButtonElement>('.console-chip').forEach((chip) => {
            chip.addEventListener('click', () => {
              input.value = chip.textContent ?? '';
              form.requestSubmit();
            });
          });

          const run = async (vibe: string) => {
            if (running) return;
            running = true;
            ensureFonts();
            panel.classList.add('running');
            input.disabled = true;
            go.disabled = true;
            resetBtn.hidden = true;
            setStatus('// designing…');
            let css = '';
            try {
              const res = await fetch('/api/redesign', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vibe }),
              });
              if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);
              const reader = res.body.getReader();
              const decoder = new TextDecoder();
              while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                css += decoder.decode(value, { stream: true });
                styleEl.textContent = css.replace(/^```(?:css)?/i, '');
                setStatus(`// designing… ${(css.length / 1024).toFixed(1)}kb`);
              }
              css = css.replace(/^```(?:css)?/i, '').replace(/```\s*$/, '');
              styleEl.textContent = css;
              localStorage.setItem('ai-css', css);
              localStorage.setItem('ai-vibe', vibe);
              setStatus(`// ${vibe}`);
            } catch (err) {
              setStatus('// something broke. try again.');
              console.error('redesign failed:', err);
            } finally {
              running = false;
              panel.classList.remove('running');
              input.disabled = false;
              go.disabled = false;
              syncState();
            }
          };

          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const vibe = input.value.trim();
            if (vibe) run(vibe);
          });

          resetBtn.addEventListener('click', () => {
            styleEl.textContent = '';
            localStorage.removeItem('ai-css');
            localStorage.removeItem('ai-vibe');
            input.value = '';
            setStatus('');
            syncState();
          });

          syncState();
        }
      }
    </script>
  </body>
</html>
