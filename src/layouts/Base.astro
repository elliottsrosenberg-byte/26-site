---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Elliott Rosenberg, designer.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GT-America-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GT-America-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var applyTheme = function () {
          try {
            var t = localStorage.getItem('theme');
            var dark = t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.documentElement.dataset.theme = 'dark';
            else delete document.documentElement.dataset.theme;
          } catch (e) {}
        };
        applyTheme();
        try {
          if (location.pathname === '/' && !sessionStorage.getItem('entered')) {
            document.documentElement.classList.add('home-enter');
            sessionStorage.setItem('entered', '1');
          }
        } catch (e) {}
        // Restore a saved AI redesign before first paint, and pin the
        // protection layer above it so the console always survives.
        try {
          var aiCss = localStorage.getItem('ai-css');
          var aiStyle = document.createElement('style');
          aiStyle.id = 'ai-style';
          if (aiCss) aiStyle.textContent = aiCss;
          document.head.appendChild(aiStyle);
          var protect = document.createElement('style');
          protect.id = 'ai-protect';
          protect.textContent =
            '[data-ai-protect] *{animation:none!important;filter:none!important;text-shadow:none!important;letter-spacing:normal!important;text-transform:none!important;}' +
            '#ai-console{position:fixed!important;right:36px!important;bottom:32px!important;background:#fbfbfb!important;color:#231e17!important;border:1px solid #e7e5e3!important;}' +
            '.console-fab{position:fixed!important;right:36px!important;bottom:32px!important;background:#fbfbfb!important;color:#857f78!important;border:1px solid #e7e5e3!important;}';
          document.head.appendChild(protect);
        } catch (e) {}
        if (!window.__baseBound) {
          window.__baseBound = true;
          document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest && e.target.closest('.theme-toggle');
            if (!btn) return;
            var root = document.documentElement;
            var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
            if (next === 'dark') root.dataset.theme = 'dark';
            else delete root.dataset.theme;
            try { localStorage.setItem('theme', next); } catch (e2) {}
          });
        }
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" transition:persist="theme-toggle">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1 A7 7 0 0 1 8 15 Z" fill="currentColor" />
      </svg>
    </button>

    <slot />

    <button class="console-fab" type="button" aria-label="Open console" data-ai-protect>
      Console
      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
        <path d="M2 6.5 L5 3.5 L8 6.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <section class="console" id="ai-console" data-ai-protect aria-label="AI redesign console">
      <header class="console-head">
        <span class="console-title">Console</span>
        <span class="console-status" aria-live="polite"></span>
        <button class="console-close" type="button" aria-label="Close console">
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M2 2 L8 8 M8 2 L2 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </header>
      <form class="console-form">
        <input class="console-input" type="text" placeholder="Describe a vibe" maxlength="300" autocomplete="off" spellcheck="false" aria-label="Describe a vibe" />
        <button class="console-go" type="submit" aria-label="Redesign">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M6 10 V2 M2.5 5.5 L6 2 L9.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
      <div class="console-chips">
        <button type="button" class="console-chip">underwater</button>
        <button type="button" class="console-chip">lo-fi computer</button>
        <button type="button" class="console-chip">y2k</button>
        <button type="button" class="console-chip">brutalist print</button>
      </div>
      <footer class="console-foot">
        <button class="console-reset" type="button" hidden>Reset design</button>
      </footer>
    </section>

    <style>
      .theme-toggle {
        position: fixed;
        top: 28px;
        right: 36px;
        z-index: 10;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: none;
        color: var(--mid);
        cursor: pointer;
        transition: color 150ms ease;
      }
      @media (hover: hover) and (pointer: fine) {
        .theme-toggle:hover { color: var(--ink); }
      }

      .console-fab {
        position: fixed;
        right: 36px;
        bottom: 32px;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border: 1px solid var(--hairline);
        border-radius: 999px;
        background: var(--bg);
        color: var(--faint);
        font: inherit;
        font-size: 15px;
        cursor: pointer;
        transition: color 150ms ease, transform 150ms var(--ease-out);
      }
      @media (hover: hover) and (pointer: fine) {
        .console-fab:hover { color: var(--mid); }
      }
      .console-fab:active { transform: scale(0.97); }

      /* ── AI redesign console. Hardcoded colors on purpose: this panel keeps
            its identity no matter what a redesign does to the page. ── */
      .console {
        position: fixed;
        right: 36px;
        bottom: 32px;
        z-index: 20;
        width: 320px;
        background: #fbfbfb;
        color: #231e17;
        border: 1px solid #e7e5e3;
        border-radius: 14px;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1);
        padding: 16px;
        font-size: 14px;
        opacity: 0;
        transform: translateY(12px) scale(0.98);
        transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out), visibility 220ms;
        visibility: hidden;
      }
      .console.open { opacity: 1; transform: none; visibility: visible; }

      .console-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .console-title { font-weight: 600; }
      .console-status { flex: 1; color: #857f78; font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .console-close {
        border: 0;
        background: none;
        color: #a5a09a;
        cursor: pointer;
        padding: 4px;
        display: grid;
        place-items: center;
        border-radius: 6px;
      }
      .console-close:hover { color: #231e17; }

      .console-form { display: flex; gap: 8px; }
      .console-input {
        flex: 1;
        min-width: 0;
        border: 1px solid #e7e5e3;
        border-radius: 8px;
        background: #ffffff;
        color: #231e17;
        font: inherit;
        font-size: 16px;
        padding: 8px 12px;
        outline: none;
      }
      .console-input:focus { border-color: #231e17; }
      .console-input:disabled { color: #a5a09a; }
      .console-go {
        flex: 0 0 38px;
        border: 0;
        border-radius: 8px;
        background: #231e17;
        color: #fbfbfb;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: transform 150ms var(--ease-out);
      }
      .console-go:active { transform: scale(0.95); }
      .console-go:disabled { background: #c9c5c1; cursor: default; }

      .console-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
      .console-chip {
        border: 1px solid #e7e5e3;
        border-radius: 999px;
        background: none;
        color: #857f78;
        font: inherit;
        font-size: 12.5px;
        padding: 4px 11px;
        cursor: pointer;
        transition: color 150ms ease, border-color 150ms ease;
      }
      .console-chip:hover { color: #231e17; border-color: #c9c5c1; }

      .console-foot { margin-top: 12px; display: flex; justify-content: flex-end; }
      .console-foot:has(.console-reset[hidden]) { display: none; }
      .console-reset {
        border: 0;
        background: none;
        color: #857f78;
        font: inherit;
        font-size: 12.5px;
        cursor: pointer;
        padding: 0;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .console-reset:hover { color: #231e17; }

      @media (max-width: 640px) {
        .theme-toggle { top: 16px; right: 16px; }
        .console-fab { right: 16px; bottom: 16px; }
        .console { right: 16px; bottom: 16px; left: 16px; width: auto; }
      }
    </style>

    <script>
      // ── AI redesign engine ─────────────────────────────────────────────
      {
        const fab = document.querySelector<HTMLButtonElement>('.console-fab');
        const panel = document.getElementById('ai-console');
        const form = panel?.querySelector<HTMLFormElement>('.console-form');
        const input = panel?.querySelector<HTMLInputElement>('.console-input');
        const go = panel?.querySelector<HTMLButtonElement>('.console-go');
        const status = panel?.querySelector<HTMLElement>('.console-status');
        const resetBtn = panel?.querySelector<HTMLButtonElement>('.console-reset');
        const styleEl = document.getElementById('ai-style') as HTMLStyleElement | null;

        if (fab && panel && form && input && go && status && resetBtn && styleEl) {
          let running = false;

          const setStatus = (t: string) => { status.textContent = t; };
          const syncState = () => {
            const vibe = localStorage.getItem('ai-vibe');
            resetBtn.hidden = !vibe && !running;
            if (vibe && !running) setStatus(`// ${vibe}`);
          };

          const openPanel = () => {
            panel.classList.add('open');
            fab.hidden = true;
            syncState();
            setTimeout(() => input.focus(), 220);
          };
          const closePanel = () => {
            panel.classList.remove('open');
            fab.hidden = false;
          };

          fab.addEventListener('click', openPanel);
          panel.querySelector('.console-close')?.addEventListener('click', closePanel);
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && panel.classList.contains('open')) closePanel();
          });

          panel.querySelectorAll<HTMLButtonElement>('.console-chip').forEach((chip) => {
            chip.addEventListener('click', () => {
              input.value = chip.textContent ?? '';
              form.requestSubmit();
            });
          });

          const run = async (vibe: string) => {
            if (running) return;
            running = true;
            input.disabled = true;
            go.disabled = true;
            resetBtn.hidden = true;
            setStatus('Designing…');
            let css = '';
            try {
              const res = await fetch('/api/redesign', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ vibe }),
              });
              if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);
              const reader = res.body.getReader();
              const decoder = new TextDecoder();
              while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                css += decoder.decode(value, { stream: true });
                styleEl.textContent = css.replace(/^```(?:css)?/i, '');
              }
              css = css.replace(/^```(?:css)?/i, '').replace(/```\s*$/, '');
              styleEl.textContent = css;
              localStorage.setItem('ai-css', css);
              localStorage.setItem('ai-vibe', vibe);
              setStatus(`// ${vibe}`);
            } catch (err) {
              setStatus('Something broke. Try again.');
              console.error('redesign failed:', err);
            } finally {
              running = false;
              input.disabled = false;
              go.disabled = false;
              syncState();
            }
          };

          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const vibe = input.value.trim();
            if (vibe) run(vibe);
          });

          resetBtn.addEventListener('click', () => {
            styleEl.textContent = '';
            localStorage.removeItem('ai-css');
            localStorage.removeItem('ai-vibe');
            input.value = '';
            setStatus('');
            syncState();
          });

          syncState();
        }
      }
    </script>
  </body>
</html>
