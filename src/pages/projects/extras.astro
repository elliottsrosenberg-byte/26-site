---
import Base from '../../layouts/Base.astro';
import MobileNav from '../../components/MobileNav.astro';

// ── Adding images ──────────────────────────────────────────────────────
// Drop the file in public/extras/ (1600px wide is plenty), then add a line
// to STATIC_TILES or PHYSICAL_TILES below: { src: '/extras/your-file.jpg',
// title: 'Name, detail' }. Order here is display order.

// Brand slideshows: click the right side for the next slide, left for the
// previous. Add slides by appending paths to an array.
const BRAND_TILES = [
  { title: 'Oneg Home', slides: [
    { src: '/extras/oneg-rebrand-1.png', w: 2000, h: 1126 }, { src: '/extras/oneg-rebrand-2.png', w: 2000, h: 1126 },
    { src: '/extras/oneg-rebrand-3.png', w: 2000, h: 1126 }, { src: '/extras/oneg-rebrand-4.jpg', w: 2000, h: 1126 },
    { src: '/extras/oneg-rebrand-5.jpg', w: 2000, h: 1126 }, { src: '/extras/oneg-rebrand-6.jpg', w: 2000, h: 1126 },
    { src: '/extras/oneg-rebrand-7.jpg', w: 2000, h: 1126 }, { src: '/extras/oneg-rebrand-8.jpg', w: 2000, h: 1126 },
    { src: '/extras/oneg-rebrand-9.jpg', w: 2000, h: 1126 },
  ] },
  { title: 'Waiting Magazine', slides: [
    { src: '/extras/wb2.jpeg', w: 3333, h: 1875 }, { src: '/extras/wb3.png', w: 3333, h: 1875 },
    { src: '/extras/wb4.jpeg', w: 3333, h: 1875 }, { src: '/extras/wb5.jpeg', w: 3333, h: 1875 },
    { src: '/extras/wb6.jpeg', w: 3333, h: 1875 }, { src: '/extras/wb7.png', w: 3333, h: 1875 },
    { src: '/extras/wb8.jpeg', w: 3333, h: 1875 },
    { src: '/extras/waiting-devices.jpg', w: 2000, h: 1125 }, { src: '/extras/ed2-small.jpg', w: 2400, h: 1768 },
  ] },
  { title: 'Studio Lauren Goodman', slides: [
    { src: '/extras/lg1.png', w: 2000, h: 1131 }, { src: '/extras/lg2.jpg', w: 2000, h: 1132 },
    { src: '/extras/lg3.jpg', w: 2000, h: 1132 },
  ] },
  { title: 'Perennial', slides: [
    { src: '/extras/PerennialType.png', w: 3068, h: 1726 },
  ] },
];

const WEB_TILES = [
  { src: '/extras/waitingSite.mp4', title: 'Waiting Magazine', href: 'https://www.waitingmag.com' },
  { src: '/extras/lgSite.mp4', title: 'Studio Lauren Goodman', href: 'https://laurengoodman.xyz' },
  { src: '/extras/siegelsite.mp4', title: 'Siegel', href: 'https://siegel.design' },
  { src: '/extras/paxSite.mp4', title: 'Pax Hand Pokes', href: 'https://paxhandpokes.com' },
  { src: '/extras/oneg-redesign.mp4', title: 'Oneg Home, realign' },
];

const VIDEO_TILES = [
  { src: '/extras/cal-nissen.mp4', title: 'Jacques Nissen, Callahan 2024', href: 'https://www.youtube.com/watch?v=uJf99sPJ7vs' },
  { src: '/extras/wtg-zarah.mp4', title: 'Waiting, meet the ED3 cover stylist', href: 'https://www.instagram.com/reel/DR2oUE1iRHc/' },
  { src: '/extras/cal-krebs.mp4', title: 'Jolie Krebs, Callahan 2024', href: 'https://www.youtube.com/watch?v=d7lv8athVaA' },
  { src: '/extras/wtg-comedy.mp4', title: 'Waiting, a comedy origin story', href: 'https://www.instagram.com/reel/DXsXZjxjTpR/' },
  { src: '/extras/cal-gordon.mp4', title: 'Leo Gordon, Callahan 2023', href: 'https://www.youtube.com/watch?v=fpV5XuxUWDM' },
  { src: '/extras/wtg-adele.mp4', title: 'Waiting, drawing Adele at The Met', href: 'https://www.instagram.com/reel/DW9EjgvDphY/' },
  { src: '/extras/cal-randolph.mp4', title: 'John Randolph, Callahan 2022', href: 'https://www.youtube.com/watch?v=UnSXCR9DoQ4' },
  { src: '/extras/wtg-afterwork.mp4', title: 'Waiting, fashion week at AFTERWORK', href: 'https://www.instagram.com/reel/DVqojQukepn/' },
  { src: '/extras/cal-villeneuve.mp4', title: 'Dylan Villeneuve, college highlights', href: 'https://www.youtube.com/watch?v=jMh3Zr1M-24' },
  { src: '/extras/wtg-service.mp4', title: 'Waiting, stories from service', href: 'https://www.instagram.com/reel/DUv6-33DT2o/' },
];

const PHYSICAL_TILES = [
  { src: '/extras/sedum-colorways.jpg', title: 'Sedum lamp, four colorways' },
  { src: '/extras/UzuHero1.jpg', title: 'Uzu chair, white oak' },
  { src: '/extras/detailWEB.jpg', title: 'Sedum lamp, cord and brass detail' },
  { src: '/extras/UzuChair-BackDetail2.jpg', title: 'Uzu chair, backrest joint' },
  { src: '/extras/LightingProcess9.jpg', title: 'Sedum lamp, prototyping' },
  { src: '/extras/oneg-candleholders.jpg', title: 'Oneg Home, turned candleholders' },
  { src: '/extras/UzuChairFrontProfile.jpg', title: 'Uzu chair, profile' },
  { src: '/extras/obj-barcart.JPG', title: 'Bar cart' },
  { src: '/extras/obj-woventable.jpg', title: 'Woven table' },
  { src: '/extras/obj-chair.JPG', title: 'Chair' },
  { src: '/extras/obj-nightstand.JPG', title: 'Nightstand' },
  { src: '/extras/obj-bench.jpg', title: 'Bench' },
  { src: '/extras/obj-jewelrybox.JPG', title: 'Jewelry box' },
  { src: '/extras/obj-stool.JPG', title: 'Stool' },
  { src: '/extras/obj-flowerbox.JPG', title: 'Flower box' },
  { src: '/extras/obj-table.JPG', title: 'Table' },
  { src: '/extras/obj-storage.JPG', title: 'Storage' },
];

const ART_TILES = [
  '/extras/art/mockstill_1.jpg', '/extras/art/IMG_0098.JPG', '/extras/art/mockstill_2.jpg',
  '/extras/art/IMG_7360.jpeg', '/extras/art/mockstill_3.jpg', '/extras/art/TheBirthOfVenusMadeInApplePages.JPG',
  '/extras/art/mockstill_5.jpg', '/extras/art/IMG_1107.JPG', '/extras/art/mockstill_6.jpg',
  '/extras/art/mockplant_1.jpg', '/extras/art/mockstill_7.jpg', '/extras/art/IMG_7852.jpeg',
  '/extras/art/mockstill_8.jpg',
];

const INTERACTIVE: { id: string; title: string }[] = [
  { id: 'field', title: 'Field' },
  { id: 'hold', title: 'Hold to confirm' },
  { id: 'linger', title: 'Tasks that linger' },
  { id: 'chain', title: 'Chain' },
  { id: 'specimen', title: 'GT America, live specimen' },
  { id: 'segmented', title: 'Segmented control' },
  { id: 'drift', title: 'Drift' },
  { id: 'command', title: 'Command fragment' },
  { id: 'clock', title: 'Clock' },
  { id: 'slider', title: 'Elastic slider' },
];

const sections = [
  { id: 'interactive', label: 'Interactive' },
  { id: 'web', label: 'Web' },
  { id: 'brand', label: 'Brand' },
  { id: 'video', label: 'Video' },
  { id: 'physical', label: 'Physical' },
  { id: 'art', label: 'Art' },
];
---
<Base title="Elliott Rosenberg / Extras" description="Selected works and experiments.">
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">Elliott Rosenberg</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-here">Extras</span>
  </nav>

  <nav class="side-nav" aria-label="Sections">
    <ul>
      {sections.map((s) => (
        <li><a href={`#${s.id}`}>{s.label}</a></li>
      ))}
    </ul>
  </nav>

  <MobileNav sections={sections.map((s) => ({ slug: s.id, text: s.label }))} />

  <main class="gallery-page">
    <section id="interactive" class="gallery-section">
      <h2 class="section-label">Interactive</h2>
      <div class="tile-grid">
        {INTERACTIVE.map((t) => (
          <figure class="tile">
            {t.id === 'field' && (
              <div class="tile-live tile-field"><canvas class="fx-canvas" data-fx="field" aria-label="A field of dots that leans toward the cursor"></canvas></div>
            )}
            {t.id === 'hold' && (
              <div class="tile-live tile-hold">
                <button class="hold-btn" type="button">
                  <span class="hold-base">Hold to delete</span>
                  <span class="hold-fill" aria-hidden="true"><span>Hold to delete</span></span>
                  <span class="hold-done" aria-hidden="true">
                    <svg width="13" height="14" viewBox="0 0 13 14" aria-hidden="true"><path d="M1 3.5 h11 M4.5 3.5 V2 a1 1 0 0 1 1-1 h2 a1 1 0 0 1 1 1 v1.5 M2.5 3.5 l0.7 8.5 a1 1 0 0 0 1 0.9 h4.6 a1 1 0 0 0 1-0.9 l0.7-8.5 M5 6 v4 M8 6 v4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Deleted
                  </span>
                </button>
              </div>
            )}
            {t.id === 'linger' && (
              <div class="tile-live tile-linger">
                <ul class="linger-list">
                  {['Order plywood samples', 'Email Sarah re: consignment', 'Invoice the Lehman commission'].map((task) => (
                    <li class="linger-item"><button type="button" class="linger-check" aria-label={`Complete: ${task}`}></button><span class="linger-text">{task}</span></li>
                  ))}
                </ul>
                <button class="linger-reset" type="button">Reset</button>
              </div>
            )}
            {t.id === 'chain' && (
              <div class="tile-live tile-chain"><canvas class="fx-canvas" data-fx="chain" aria-label="A chain of dots that follows the cursor with lag"></canvas></div>
            )}
            {t.id === 'specimen' && (
              <div class="tile-live tile-specimen" tabindex="0" aria-label="Interactive type specimen. Move the pointer to change weight and spacing.">
                <span class="specimen-word">extras</span>
                <span class="specimen-meta"><span class="specimen-weight">400</span> · GT America</span>
              </div>
            )}
            {t.id === 'segmented' && (
              <div class="tile-live tile-segmented">
                <div class="seg" role="tablist">
                  <span class="seg-thumb" aria-hidden="true"></span>
                  {['Day', 'Auto', 'Night'].map((o, i) => (
                    <button type="button" class="seg-opt" role="tab" aria-selected={i === 1 ? 'true' : 'false'}>{o}</button>
                  ))}
                </div>
              </div>
            )}
            {t.id === 'drift' && (
              <div class="tile-live tile-drift"><canvas class="fx-canvas" data-fx="drift" aria-label="Particles drifting slowly. Click to scatter them like touched water."></canvas></div>
            )}
            {t.id === 'command' && (
              <div class="tile-live tile-command">
                <input class="cmd-input" type="text" placeholder="Type a command" autocomplete="off" spellcheck="false" aria-label="Filter commands" />
                <ul class="cmd-list">
                  {['Create invoice', 'Log time', 'New project', 'Add contact', 'Open calendar', 'Search notes'].map((c) => (
                    <li class="cmd-row" tabindex="-1">{c}</li>
                  ))}
                  <li class="cmd-empty" hidden>No matching commands</li>
                </ul>
              </div>
            )}
            {t.id === 'clock' && (
              <div class="tile-live tile-clock">
                <svg class="clock-svg" viewBox="0 0 200 200" aria-label="The current time as three rings">
                  <circle class="ring ring-h" cx="100" cy="100" r="80" />
                  <circle class="ring ring-m" cx="100" cy="100" r="62" />
                  <circle class="ring ring-s" cx="100" cy="100" r="44" />
                </svg>
                <span class="clock-label"></span>
                <div class="clock-zoom">
                  <button type="button" class="zoom-btn" data-zoom="out" aria-label="Zoom out">&minus;</button>
                  <button type="button" class="zoom-btn" data-zoom="in" aria-label="Zoom in">+</button>
                </div>
              </div>
            )}
            {t.id === 'slider' && (
              <div class="tile-live tile-slider">
                <svg class="slider-svg" viewBox="0 0 320 80">
                  <path class="slider-track" d="M 16 40 L 304 40" />
                  <circle class="slider-thumb" cx="160" cy="40" r="9" />
                </svg>
                <span class="slider-value">50</span>
              </div>
            )}
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="web" class="gallery-section">
      <h2 class="section-label">Web</h2>
      <div class="tile-grid tile-grid-single">
        {WEB_TILES.map((t) => (
          <figure class="tile">
            {t.href ? (
              <a href={t.href} target="_blank" rel="noopener" aria-label={`${t.title}, opens the live site`}>
                <video src={t.src} autoplay muted loop playsinline preload="metadata"></video>
              </a>
            ) : (
              <video src={t.src} autoplay muted loop playsinline preload="metadata"></video>
            )}
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="brand" class="gallery-section">
      <h2 class="section-label">Brand</h2>
      <div class="tile-grid tile-grid-single">
        {BRAND_TILES.map((b) => (
          <figure class="tile">
            <div class="slides" tabindex="0" role="group" aria-label={`${b.title}, ${b.slides.length} ${b.slides.length === 1 ? 'slide' : 'slides'}`} data-count={b.slides.length}>
              {b.slides.map((sl, i) => (
                <img src={sl.src} width={sl.w} height={sl.h} alt={`${b.title}, slide ${i + 1} of ${b.slides.length}`} loading="lazy" class={i === 0 ? 'on' : undefined} />
              ))}
              {b.slides.length > 1 && (
                <>
                  <span class="slide-zone slide-zone-prev" aria-hidden="true"></span>
                  <span class="slide-zone slide-zone-next" aria-hidden="true"></span>
                  <span class="slide-count">1 / {b.slides.length}</span>
                </>
              )}
            </div>
            <figcaption><span class="tile-title">{b.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="video" class="gallery-section">
      <h2 class="section-label">Video</h2>
      <div class="tile-grid">
        {VIDEO_TILES.map((t) => (
          <figure class="tile">
            <a href={t.href} target="_blank" rel="noopener" aria-label={`${t.title}, opens the full video`}>
              <video src={t.src} autoplay muted loop playsinline preload="metadata"></video>
            </a>
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="physical" class="gallery-section">
      <h2 class="section-label">Physical</h2>
      <div class="tile-grid">
        {PHYSICAL_TILES.map((t) => (
          <figure class="tile">
            <img src={t.src} alt={t.title} loading="lazy" />
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="art" class="gallery-section">
      <h2 class="section-label">Art</h2>
      <div class="tile-grid">
        {ART_TILES.map((src) => (
          <figure class="tile">
            <img src={src} alt="" loading="lazy" />
          </figure>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .crumb { position: fixed; top: 34px; left: 40px; z-index: 10; font-size: 15px; }
  .crumb a { text-decoration: none; color: var(--mid); transition: color 150ms ease; }
  @media (hover: hover) and (pointer: fine) { .crumb a:hover { color: var(--ink); } }
  .crumb-sep { color: var(--faint); margin: 0 4px; }
  .crumb-here { color: var(--faint); }

  .side-nav {
    position: fixed;
    top: 200px;
    left: 32px;
    max-width: 150px;
    font-size: 15px;
    transition: opacity 200ms ease, visibility 200ms;
  }
  /* The 912 measure needs more room than the piece pages' 680 before the
     sidebar fits without overlap. */
  @media (max-width: 1359px) { .side-nav { opacity: 0; visibility: hidden; } }
  .side-nav ul { margin: 0; padding: 0; list-style: none; }
  .side-nav li { margin-bottom: 10px; }
  .side-nav a {
    position: relative;
    color: var(--faint);
    text-decoration: none;
    transition: color 150ms ease;
    padding-left: 12px;
    margin-left: -12px;
  }
  .side-nav a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .side-nav a:hover { color: var(--mid); } }
  .side-nav a.active { color: var(--ink); }
  .side-nav a.active::before { opacity: 1; }

  /* Same centered geometry as home: the 912px measure, two tile columns. */
  .gallery-page {
    max-width: calc(var(--measure) + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 150px var(--pad-x) 120px;
  }

  .gallery-section { margin-bottom: 72px; animation: rise 400ms var(--ease-out) backwards; }
  .gallery-section:last-child { margin-bottom: 0; }
  .section-label {
    margin: 0 0 28px calc(-1 * var(--outdent));
    font-size: inherit;
    font-weight: 400;
    color: var(--faint);
  }

  .tile-grid { columns: 2; column-gap: 24px; }
  .tile-grid-single { columns: 1; }
  .tile { break-inside: avoid; margin: 0 0 40px; }
  .tile img,
  .tile video {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    display: block;
  }
  .tile figcaption { margin-top: 10px; font-size: 13px; color: var(--mid); }

  /* Brand slideshows: each slide at its natural size, the container
     animating between slide heights; arrow cursors mark the two zones. */
  .slides { position: relative; overflow: hidden; transition: height 300ms var(--ease-out); }
  .slides img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
    pointer-events: none;
  }
  .slides img.on { opacity: 1; }
  .slides[data-count='1'] { transition: none; }
  .slide-zone { position: absolute; top: 0; bottom: 0; z-index: 1; }
  .slide-zone-prev {
    left: 0;
    width: 33.4%;
    cursor: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='26' height='26'%3E%3Ccircle cx='13' cy='13' r='12' fill='%23fbfbfb' stroke='%23c9c5c1'/%3E%3Cpath d='M15 8l-5 5 5 5' stroke='%23231e17' stroke-width='1.8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") 13 13, w-resize;
  }
  .slide-zone-next {
    right: 0;
    width: 66.6%;
    cursor: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='26' height='26'%3E%3Ccircle cx='13' cy='13' r='12' fill='%23fbfbfb' stroke='%23c9c5c1'/%3E%3Cpath d='M11 8l5 5-5 5' stroke='%23231e17' stroke-width='1.8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") 13 13, e-resize;
  }
  .slide-count {
    position: absolute;
    right: 12px;
    bottom: 10px;
    font-size: 12px;
    color: var(--mid);
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 3px 10px;
    font-variant-numeric: tabular-nums;
    z-index: 2;
  }

  .tile-live {
    touch-action: manipulation;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    overflow: hidden;
    position: relative;
    padding: 24px;
  }

  .tile-field, .tile-chain, .tile-drift { height: 340px; padding: 0; }
  .fx-canvas { width: 100%; height: 100%; display: block; }

  /* Hold to confirm */
  .tile-hold { height: 200px; display: grid; place-items: center; padding: 0; }
  .hold-btn {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    padding: 10px 22px;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    touch-action: none;
    transition: transform 150ms var(--ease-out), border-color 200ms ease, color 200ms ease;
  }
  .hold-btn.holding { transform: scale(0.96); }
  .hold-base { position: relative; }
  .hold-fill {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #da4126;
    color: #ffffff;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 250ms var(--ease-out);
  }
  .hold-btn.holding .hold-fill { clip-path: inset(0 0 0 0); transition: clip-path 1500ms linear; }
  .hold-done {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: #da4126;
  }
  .hold-btn.confirmed {
    border-color: #da4126;
    color: #da4126;
    animation: hold-spring 450ms var(--ease-out);
  }
  .hold-btn.confirmed .hold-base { visibility: hidden; }
  .hold-btn.confirmed .hold-fill { display: none; }
  .hold-btn.confirmed .hold-done { display: flex; }
  @keyframes hold-spring {
    0% { transform: scale(0.96); }
    45% { transform: scale(1.04); }
    75% { transform: scale(0.99); }
    100% { transform: scale(1); }
  }

  /* Tasks that linger */
  .linger-list { margin: 0; padding: 0; list-style: none; }
  .linger-item {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    max-height: 44px;
    overflow: hidden;
    transition: max-height 300ms var(--ease-out), opacity 300ms ease;
    padding: 8px 0;
  }
  .linger-item.gone { max-height: 0; opacity: 0; padding-block: 0; }
  .linger-check {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    border: 1.5px solid var(--mid);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .linger-item.done .linger-check { background: var(--ink); border-color: var(--ink); }
  .linger-item.done .linger-check::after { content: ''; width: 5px; height: 8px; border: solid var(--bg); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg) translateY(-1px); }
  .linger-text { font-size: 15px; color: var(--ink); transition: color 200ms ease; }
  .linger-item.done .linger-text { color: var(--faint); text-decoration: line-through; }
  .linger-reset { margin-top: 10px; border: 0; background: none; font: inherit; font-size: 13px; color: var(--faint); cursor: pointer; padding: 0; }
  .linger-reset:hover { color: var(--mid); }

  /* Specimen */
  .tile-specimen { height: 300px; display: grid; place-items: center; cursor: crosshair; user-select: none; padding: 0; }
  .specimen-word { font-size: 72px; font-weight: 400; color: var(--ink); letter-spacing: 0; line-height: 1; }
  .specimen-meta { position: absolute; left: 20px; bottom: 16px; font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums; }

  /* Segmented */
  .tile-segmented { height: 160px; display: grid; place-items: center; }
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 88px);
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 3px;
  }
  .seg-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px) / 3);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    transform: translateX(100%);
    transition: transform 250ms var(--ease-out);
  }
  .seg-opt {
    position: relative;
    z-index: 1;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--mid);
    padding: 7px 0;
    cursor: pointer;
    transition: color 150ms ease;
  }
  .seg-opt[aria-selected='true'] { color: var(--ink); }

  /* Command */
  .cmd-input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--faint);
    background: none;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    padding: 4px 0 8px;
    margin-bottom: 10px;
    outline: none;
  }
  .cmd-input:focus { border-bottom-color: var(--ink); }
  /* The list reserves its full height so filtering never reflows the grid. */
  .cmd-list { margin: 0; padding: 0; list-style: none; min-height: 216px; }
  .cmd-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: var(--ink);
    padding: 7px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .cmd-row.active { background: var(--bg); }
  .cmd-row[hidden] { display: none; }
  .cmd-row.run { background: var(--ink); color: var(--bg); }
  .cmd-row::after {
    content: '';
    width: 5px;
    height: 9px;
    margin-right: 3px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg) translateY(-1px);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .cmd-row.run::after { opacity: 1; }
  .cmd-empty { font-size: 14px; color: var(--faint); padding: 7px 10px; }

  /* Clock */
  .tile-clock { height: 300px; display: grid; place-items: center; padding: 0; overflow: hidden; }
  .clock-svg { transition: transform 500ms var(--ease-out); will-change: transform; }
  .ring { fill: none; stroke-linecap: round; transform: rotate(-90deg); transform-origin: center; }
  .ring-h { stroke: var(--ink); stroke-width: 3; }
  .ring-m { stroke: var(--mid); stroke-width: 2.5; }
  .ring-s { stroke: var(--faint); stroke-width: 2; }
  .clock-label { position: absolute; left: 20px; bottom: 16px; font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums; }
  .clock-zoom { position: absolute; right: 14px; bottom: 12px; display: flex; gap: 6px; }
  .zoom-btn {
    width: 28px;
    height: 28px;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--bg);
    color: var(--mid);
    font: inherit;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: color 150ms ease, transform 150ms var(--ease-out);
  }
  .zoom-btn:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .zoom-btn:hover { color: var(--ink); } }

  /* Elastic slider */
  .tile-slider { height: 160px; display: grid; place-items: center; }
  .slider-svg { width: 100%; height: 80px; display: block; touch-action: none; }
  .slider-track { fill: none; stroke: var(--faint); stroke-width: 2; stroke-linecap: round; }
  .slider-thumb { fill: var(--ink); cursor: grab; }
  .slider-value { position: absolute; right: 20px; bottom: 16px; font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .crumb { position: static; padding: 20px var(--pad-x) 16px; }
    .gallery-page { padding-top: 40px; }
    .gallery-section { scroll-margin-top: 64px; }
  }
  @media (max-width: 640px) {
    .tile-grid { columns: 1; }
    .gallery-section { margin-bottom: 56px; }
  }
</style>

<script>
  // ── Scrollspy: the active section is the last one whose top has passed
  //    a line 30% down the viewport. Robust for sections taller than the
  //    screen.
  {
    const nav = document.querySelector('.side-nav');
    if (nav) {
      const links = [...nav.querySelectorAll('a')] as HTMLAnchorElement[];
      const byId = new Map(links.map((a) => [a.hash.slice(1), a] as const));
      const secs = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
      const setActive = (id: string) => links.forEach((a) => a.classList.toggle('active', a === byId.get(id)));
      const update = () => {
        const line = innerHeight * 0.3;
        let cur = secs[0]?.id;
        for (const el of secs) if (el.getBoundingClientRect().top <= line) cur = el.id;
        if (cur) setActive(cur);
      };
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }
  }


  // Brand slideshows: zoned prev/next with animated height, slides
  //   preloaded as the show approaches the viewport.
  document.querySelectorAll<HTMLElement>('.slides').forEach((box) => {
    const imgs = [...box.querySelectorAll('img')];
    const count = box.querySelector<HTMLElement>('.slide-count');
    let i = 0;
    const fit = () => {
      const im = imgs[i];
      const w = Number(im.getAttribute('width')), h = Number(im.getAttribute('height'));
      if (w && h) box.style.height = `${(box.clientWidth * h) / w}px`;
    };
    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((im, j) => im.classList.toggle('on', j === i));
      if (count) count.textContent = `${i + 1} / ${imgs.length}`;
      fit();
    };
    new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      imgs.forEach((im) => { im.loading = 'eager'; });
      fit();
    }, { rootMargin: '600px 0px' }).observe(box);
    new ResizeObserver(fit).observe(box);
    if (imgs.length < 2) return;
    box.querySelector('.slide-zone-prev')?.addEventListener('click', () => show(i - 1));
    box.querySelector('.slide-zone-next')?.addEventListener('click', () => show(i + 1));
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
    });
  });

  // Looping site videos play only while on screen.
  {
    const vids = document.querySelectorAll<HTMLVideoElement>('.tile video[autoplay]');
    if (vids.length) {
      const vio = new IntersectionObserver(
        (es) => es.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
        { threshold: 0.2 }
      );
      vids.forEach((v) => vio.observe(v));
    }
  }

  // ── Canvas helper: sized, dpr-aware, running only while on screen.
  function canvasFx(el: HTMLCanvasElement, draw: (ctx: CanvasRenderingContext2D, w: number, h: number, t: number) => void, animated: boolean) {
    const ctx = el.getContext('2d')!;
    let w = 0, h = 0, raf: number | null = null, visible = false;
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = el.clientWidth; h = el.clientHeight;
      el.width = w * dpr; el.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(ctx, w, h, performance.now());
    };
    const loop = (t: number) => { draw(ctx, w, h, t); raf = visible ? requestAnimationFrame(loop) : null; };
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (visible) { resize(); if (animated && raf === null) raf = requestAnimationFrame(loop); }
      else if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
    }).observe(el);
    addEventListener('resize', () => { if (visible) resize(); });
    resize();
    return { redraw: () => draw(ctx, w, h, performance.now()) };
  }
  const tokens = () => {
    const cs = getComputedStyle(document.documentElement);
    return { faint: cs.getPropertyValue('--faint').trim(), mid: cs.getPropertyValue('--mid').trim(), ink: cs.getPropertyValue('--ink').trim(), surface: cs.getPropertyValue('--surface').trim() };
  };

  // ── Field
  {
    const el = document.querySelector<HTMLCanvasElement>('[data-fx="field"]');
    if (el) {
      let mx = -9999, my = -9999;
      const GAP = 26;
      const fx = canvasFx(el, (ctx, w, h) => {
        const { faint, ink } = tokens();
        ctx.clearRect(0, 0, w, h);
        for (let x = GAP / 2; x < w; x += GAP) for (let y = GAP / 2; y < h; y += GAP) {
          const dx = mx - x, dy = my - y, d = Math.hypot(dx, dy);
          const pull = Math.max(0, 1 - d / 150);
          const ox = d > 0 ? (dx / d) * pull * 7 : 0, oy = d > 0 ? (dy / d) * pull * 7 : 0;
          ctx.fillStyle = pull > 0.02 ? ink : faint;
          ctx.globalAlpha = 0.35 + pull * 0.65;
          ctx.beginPath(); ctx.arc(x + ox, y + oy, 1.5 + pull * 1.2, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }, false);
      const point = (e: PointerEvent) => {
        const r = el.getBoundingClientRect(); mx = e.clientX - r.left; my = e.clientY - r.top; fx.redraw();
      };
      el.addEventListener('pointermove', point);
      el.addEventListener('pointerdown', point);
      el.addEventListener('pointerleave', () => { mx = -9999; my = -9999; fx.redraw(); });
    }
  }

  // ── Chain: segments ease toward the one before them; click sends a pulse.
  {
    const el = document.querySelector<HTMLCanvasElement>('[data-fx="chain"]');
    if (el) {
      const N = 14;
      const pts = Array.from({ length: N }, () => ({ x: 100, y: 100 }));
      let tx = 160, ty = 160;
      let pulse = 0;
      let ring: { x: number; y: number; r: number; a: number } | null = null;
      canvasFx(el, (ctx, w, h) => {
        const { ink, faint } = tokens();
        pts[0].x += (tx - pts[0].x) * 0.22; pts[0].y += (ty - pts[0].y) * 0.22;
        for (let i = 1; i < N; i++) {
          pts[i].x += (pts[i - 1].x - pts[i].x) * 0.22;
          pts[i].y += (pts[i - 1].y - pts[i].y) * 0.22;
        }
        pulse *= 0.9;
        ctx.clearRect(0, 0, w, h);
        if (ring) {
          ring.r += 3.5; ring.a *= 0.93;
          ctx.strokeStyle = ink; ctx.globalAlpha = ring.a; ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.arc(ring.x, ring.y, ring.r, 0, Math.PI * 2); ctx.stroke();
          ctx.globalAlpha = 1;
          if (ring.a < 0.02) ring = null;
        }
        ctx.strokeStyle = faint; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < N; i++) ctx.lineTo(pts[i].x, pts[i].y);
        ctx.stroke();
        for (let i = 0; i < N; i++) {
          ctx.fillStyle = ink;
          ctx.globalAlpha = 1 - (i / N) * 0.8;
          ctx.beginPath(); ctx.arc(pts[i].x, pts[i].y, 4 - (i / N) * 2.5 + pulse * 3, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }, true);
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(); tx = e.clientX - r.left; ty = e.clientY - r.top;
      });
      el.addEventListener('pointerdown', (e) => {
        const r = el.getBoundingClientRect();
        tx = e.clientX - r.left; ty = e.clientY - r.top;
        pulse = 1;
        ring = { x: tx, y: ty, r: 6, a: 0.5 };
      });
    }
  }

  // ── Drift: slow particles with faint trails; a click scatters them.
  {
    const el = document.querySelector<HTMLCanvasElement>('[data-fx="drift"]');
    if (el) {
      type P = { x: number; y: number; a: number; vx: number; vy: number };
      let ps: P[] = [];
      let seeded = false;
      canvasFx(el, (ctx, w, h) => {
        const { mid, surface } = tokens();
        if (!seeded) {
          ps = Array.from({ length: 50 }, () => ({ x: Math.random() * w, y: Math.random() * h, a: Math.random() * Math.PI * 2, vx: 0, vy: 0 }));
          seeded = true;
          ctx.clearRect(0, 0, w, h);
        }
        ctx.fillStyle = surface;
        ctx.globalAlpha = 0.16;
        ctx.fillRect(0, 0, w, h);
        ctx.globalAlpha = 0.8;
        ctx.fillStyle = mid;
        for (const p of ps) {
          p.a += (Math.random() - 0.5) * 0.25;
          p.x += Math.cos(p.a) * 0.7 + p.vx;
          p.y += Math.sin(p.a) * 0.7 + p.vy;
          p.vx *= 0.9; p.vy *= 0.9;
          if (p.x < 0) p.x = w; if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h; if (p.y > h) p.y = 0;
          ctx.beginPath(); ctx.arc(p.x, p.y, 1.4, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }, true);
      el.addEventListener('pointerdown', (e) => {
        const r = el.getBoundingClientRect();
        const cx = e.clientX - r.left, cy = e.clientY - r.top;
        for (const p of ps) {
          const dx = p.x - cx, dy = p.y - cy, d = Math.hypot(dx, dy);
          if (d < 130 && d > 0.01) {
            const k = (1 - d / 130) * 7;
            p.vx += (dx / d) * k;
            p.vy += (dy / d) * k;
          }
        }
      });
    }
  }

  // ── Hold to confirm.
  {
    const btn = document.querySelector<HTMLButtonElement>('.hold-btn');
    if (btn) {
      let timer: ReturnType<typeof setTimeout> | null = null;
      const arm = () => {
        if (btn.classList.contains('confirmed')) return;
        btn.classList.add('holding');
        timer = setTimeout(() => {
          btn.classList.remove('holding');
          btn.classList.add('confirmed');
          setTimeout(() => btn.classList.remove('confirmed'), 1800);
        }, 1500);
      };
      const disarm = () => { btn.classList.remove('holding'); if (timer) { clearTimeout(timer); timer = null; } };
      btn.addEventListener('pointerdown', arm);
      btn.addEventListener('pointerup', disarm);
      btn.addEventListener('pointerleave', disarm);
      btn.addEventListener('pointercancel', disarm);
      btn.addEventListener('contextmenu', (e) => e.preventDefault());
    }
  }

  // ── Tasks that linger (650ms, like Perennial's task list).
  {
    const items = [...document.querySelectorAll<HTMLElement>('.linger-item')];
    items.forEach((item) => {
      item.addEventListener('click', () => {
        if (item.classList.contains('done')) return;
        item.classList.add('done');
        setTimeout(() => item.classList.add('gone'), 650);
      });
    });
    document.querySelector('.linger-reset')?.addEventListener('click', () => {
      items.forEach((i) => i.classList.remove('done', 'gone'));
    });
  }

  // ── Specimen.
  {
    const spec = document.querySelector<HTMLElement>('.tile-specimen');
    const word = document.querySelector<HTMLElement>('.specimen-word');
    const label = document.querySelector<HTMLElement>('.specimen-weight');
    const WEIGHTS = [300, 400, 500, 600];
    if (spec && word && label) {
      spec.addEventListener('pointermove', (e) => {
        const r = spec.getBoundingClientRect();
        const fx = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 0.999);
        const fy = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
        const wt = WEIGHTS[Math.floor(fx * WEIGHTS.length)];
        word.style.fontWeight = String(wt);
        word.style.letterSpacing = `${((fy - 0.5) * 0.12).toFixed(3)}em`;
        label.textContent = String(wt);
      });
      spec.addEventListener('click', () => {
        const cur = Number(word.style.fontWeight || 400);
        const next = WEIGHTS[(WEIGHTS.indexOf(cur) + 1) % WEIGHTS.length];
        word.style.fontWeight = String(next);
        label.textContent = String(next);
      });
    }
  }

  // ── Segmented control.
  {
    const seg = document.querySelector<HTMLElement>('.seg');
    const thumb = seg?.querySelector<HTMLElement>('.seg-thumb');
    const opts = seg ? [...seg.querySelectorAll<HTMLButtonElement>('.seg-opt')] : [];
    if (thumb && opts.length) {
      opts.forEach((o, i) => o.addEventListener('click', () => {
        opts.forEach((x) => x.setAttribute('aria-selected', String(x === o)));
        thumb.style.transform = `translateX(${i * 100}%)`;
      }));
    }
  }

  // ── Command fragment: keyboard and pointer, honest empty state.
  {
    const input = document.querySelector<HTMLInputElement>('.cmd-input');
    const rows = [...document.querySelectorAll<HTMLElement>('.cmd-row')];
    const empty = document.querySelector<HTMLElement>('.cmd-empty');
    if (input && rows.length && empty) {
      let idx = 0;
      const visible = () => rows.filter((r) => !r.hidden);
      const paint = () => {
        const v = visible();
        rows.forEach((r) => r.classList.remove('active'));
        empty.hidden = v.length > 0;
        if (v.length) { idx = Math.min(idx, v.length - 1); v[idx].classList.add('active'); }
      };
      let runTimer: ReturnType<typeof setTimeout> | null = null;
      const run = (row: HTMLElement) => {
        rows.forEach((r) => r.classList.remove('run'));
        void row.offsetWidth;
        row.classList.add('run');
        if (runTimer) clearTimeout(runTimer);
        runTimer = setTimeout(() => row.classList.remove('run'), 900);
      };
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        rows.forEach((r) => { r.hidden = q !== '' && !r.textContent!.toLowerCase().includes(q); });
        idx = 0; paint();
      });
      // Run, let the confirmation land where it is, then clear and restore.
      const commit = (row: HTMLElement) => {
        run(row);
        setTimeout(() => {
          input.value = '';
          rows.forEach((r) => { r.hidden = false; });
          idx = rows.indexOf(row);
          paint();
        }, 950);
      };
      input.addEventListener('keydown', (e) => {
        const v = visible();
        if (e.key === 'ArrowDown') { e.preventDefault(); idx = Math.min(idx + 1, v.length - 1); paint(); }
        if (e.key === 'ArrowUp') { e.preventDefault(); idx = Math.max(idx - 1, 0); paint(); }
        if (e.key === 'Enter' && v[idx]) commit(v[idx]);
      });
      rows.forEach((r) => {
        r.addEventListener('mouseenter', () => { const v = visible(); const j = v.indexOf(r); if (j >= 0) { idx = j; paint(); } });
        r.addEventListener('click', () => commit(r));
      });
      paint();
    }
  }

  // ── Clock: three rings, zoomable by buttons or wheel.
  {
    const tile = document.querySelector<HTMLElement>('.tile-clock');
    const svg = document.querySelector<SVGElement>('.clock-svg');
    const label = document.querySelector<HTMLElement>('.clock-label');
    if (tile && svg && label) {
      const rings = {
        h: svg.querySelector<SVGCircleElement>('.ring-h')!,
        m: svg.querySelector<SVGCircleElement>('.ring-m')!,
        s: svg.querySelector<SVGCircleElement>('.ring-s')!,
      };
      const setRing = (c: SVGCircleElement, frac: number) => {
        const r = Number(c.getAttribute('r'));
        const circ = 2 * Math.PI * r;
        c.style.strokeDasharray = `${circ}`;
        c.style.strokeDashoffset = `${circ * (1 - Math.max(frac, 0.002))}`;
      };
      const update = () => {
        const d = new Date();
        setRing(rings.h, (d.getHours() % 12) / 12 + d.getMinutes() / 60 / 12);
        setRing(rings.m, d.getMinutes() / 60 + d.getSeconds() / 3600);
        setRing(rings.s, d.getSeconds() / 60);
        label.textContent = d.toTimeString().slice(0, 8);
      };
      update();
      setInterval(update, 1000);

      let zoom = 1;
      const apply = () => { (svg as unknown as HTMLElement).style.transform = `scale(${zoom})`; };
      const clamp = (z: number) => Math.min(Math.max(z, 0.4), 3);
      tile.querySelectorAll<HTMLButtonElement>('.zoom-btn').forEach((b) => {
        b.addEventListener('click', () => { zoom = clamp(zoom * (b.dataset.zoom === 'in' ? 1.25 : 0.8)); apply(); });
      });
      tile.addEventListener('wheel', (e) => {
        e.preventDefault();
        zoom = clamp(zoom * Math.exp(-e.deltaY * 0.0012));
        apply();
      }, { passive: false });
    }
  }

  // ── Elastic slider: the thumb always springs home to center.
  {
    const svg = document.querySelector<SVGSVGElement>('.slider-svg');
    const track = document.querySelector<SVGPathElement>('.slider-track');
    const thumb = document.querySelector<SVGCircleElement>('.slider-thumb');
    const out = document.querySelector<HTMLElement>('.slider-value');
    if (svg && track && thumb && out) {
      const X0 = 16, X1 = 304, CX = 160, CY = 40;
      let x = CX, bend = 0, dragging = false, raf: number | null = null;
      let vx = 0, vb = 0;
      const paint = () => {
        track.setAttribute('d', `M ${X0} ${CY} Q ${x} ${CY + bend} ${X1} ${CY}`);
        thumb.setAttribute('cx', String(x));
        thumb.setAttribute('cy', String(CY + bend / 2));
        out.textContent = String(Math.round(((x - X0) / (X1 - X0)) * 100));
      };
      const settle = () => {
        vx += (CX - x) * 0.11; vx *= 0.84; x += vx;
        vb += -bend * 0.16; vb *= 0.84; bend += vb;
        paint();
        if (Math.abs(CX - x) > 0.2 || Math.abs(vx) > 0.2 || Math.abs(bend) > 0.2 || Math.abs(vb) > 0.2) {
          raf = requestAnimationFrame(settle);
        } else {
          x = CX; bend = 0; vx = 0; vb = 0; paint(); raf = null;
        }
      };
      const toLocal = (e: PointerEvent) => {
        const r = svg.getBoundingClientRect();
        return { x: ((e.clientX - r.left) / r.width) * 320, y: ((e.clientY - r.top) / r.height) * 80 };
      };
      const grab = (e: PointerEvent) => {
        dragging = true;
        try { svg.setPointerCapture(e.pointerId); } catch (err) {}
        if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
        const p = toLocal(e);
        x = Math.min(Math.max(p.x, X0), X1);
        bend = Math.min(Math.max(p.y - CY, -26), 26);
        paint();
      };
      svg.addEventListener('pointerdown', grab);
      svg.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const p = toLocal(e);
        x = Math.min(Math.max(p.x, X0), X1);
        bend = Math.min(Math.max(p.y - CY, -26), 26);
        paint();
      });
      const release = () => {
        if (!dragging) return;
        dragging = false;
        if (raf === null) raf = requestAnimationFrame(settle);
      };
      svg.addEventListener('pointerup', release);
      svg.addEventListener('pointercancel', release);
      paint();
    }
  }
</script>
