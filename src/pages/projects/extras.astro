---
import Base from '../../layouts/Base.astro';

// ── Adding images ──────────────────────────────────────────────────────
// Drop the file in public/extras/ (1600px wide is plenty), then add a line
// to STATIC_TILES or PHYSICAL_TILES below: { src: '/extras/your-file.jpg',
// title: 'Name, detail' }. Order here is display order.

const STATIC_TILES = [
  { src: '/media/perennial/home.png', title: 'Perennial, home canvas' },
  { src: '/extras/waiting-p01.jpg', title: 'Waiting Magazine, spread 01' },
  { src: '/extras/prnl-login-light.png', title: 'Perennial, login' },
  { src: '/extras/waiting-p02.jpg', title: 'Waiting Magazine, spread 02' },
  { src: '/extras/oneg-p01.jpg', title: 'Oneg Home, brand pages' },
  { src: '/extras/prnl-calendar.png', title: 'Perennial, calendar' },
  { src: '/extras/waiting-p03.jpg', title: 'Waiting Magazine, spread 03' },
  { src: '/extras/prnl-home-dark.png', title: 'Perennial, dark mode' },
  { src: '/extras/oneg-p02.jpg', title: 'Oneg Home, product pages' },
  { src: '/media/perennial/outreach.png', title: 'Perennial, outreach' },
  { src: '/extras/waiting-p04.jpg', title: 'Waiting Magazine, spread 04' },
];

const PHYSICAL_TILES = [
  { src: '/extras/sedum-p01.jpg', title: 'Sedum lamp' },
  { src: '/extras/sedum-p02.jpg', title: 'Sedum lamp, detail' },
  { src: '/extras/sedum-p03.jpg', title: 'Sedum lamp, process' },
  { src: '/extras/sedum-p04.jpg', title: 'Sedum lamp, in situ' },
];

// Interactive tiles are hand-built below; order here is display order.
const INTERACTIVE: { id: string; title: string }[] = [
  { id: 'field', title: 'Field' },
  { id: 'hold', title: 'Hold to confirm' },
  { id: 'palette', title: 'Every word has a color' },
  { id: 'linger', title: 'Tasks that linger' },
  { id: 'chain', title: 'Chain' },
  { id: 'ash', title: 'Space for Ash' },
  { id: 'specimen', title: 'GT America, live specimen' },
  { id: 'segmented', title: 'Segmented control' },
  { id: 'drift', title: 'Drift' },
  { id: 'toasts', title: 'Toast choreography' },
  { id: 'command', title: 'Command fragment' },
  { id: 'clock', title: 'Clock' },
  { id: 'slider', title: 'Elastic slider' },
];

const sections = [
  { id: 'interactive', label: 'Interactive' },
  { id: 'static', label: 'Static' },
  { id: 'physical', label: 'Physical' },
];
---
<Base title="Elliott Rosenberg / Extras" description="Selected works and experiments.">
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">Elliott Rosenberg</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-here">Extras</span>
  </nav>

  <nav class="side-nav" aria-label="Sections">
    <ul>
      {sections.map((s) => (
        <li><a href={`#${s.id}`}>{s.label}</a></li>
      ))}
    </ul>
  </nav>

  <main class="gallery-page">
    <section id="interactive" class="gallery-section">
      <h2 class="section-label">Interactive</h2>
      <div class="tile-grid">
        {INTERACTIVE.map((t) => (
          <figure class="tile">
            {t.id === 'field' && (
              <div class="tile-live tile-field"><canvas class="fx-canvas" data-fx="field" aria-label="A field of dots that leans toward the cursor"></canvas></div>
            )}
            {t.id === 'hold' && (
              <div class="tile-live tile-hold">
                <p class="tile-hint">Destructive actions earn a beat of friction.</p>
                <button class="hold-btn" type="button"><span class="hold-fill" aria-hidden="true"></span><span class="hold-text">Hold to delete</span></button>
              </div>
            )}
            {t.id === 'palette' && (
              <div class="tile-live tile-palette">
                <label class="tile-hint" for="palette-input">Type a word. The hash picks its color, the same way Perennial colors every tag.</label>
                <input id="palette-input" class="palette-input" type="text" value="perennial" maxlength="24" autocomplete="off" spellcheck="false" />
                <div class="palette-chip" aria-live="polite"><span class="palette-swatch"></span><span class="palette-name"></span></div>
              </div>
            )}
            {t.id === 'linger' && (
              <div class="tile-live tile-linger">
                <p class="tile-hint">Perennial's task list lets a finished task linger before it goes.</p>
                <ul class="linger-list">
                  {['Order plywood samples', 'Email Sarah re: consignment', 'Invoice the Lehman commission'].map((task) => (
                    <li class="linger-item"><button type="button" class="linger-check" aria-label={`Complete: ${task}`}></button><span class="linger-text">{task}</span></li>
                  ))}
                </ul>
                <button class="linger-reset" type="button">Reset</button>
              </div>
            )}
            {t.id === 'chain' && (
              <div class="tile-live tile-chain"><canvas class="fx-canvas" data-fx="chain" aria-label="A chain of dots that follows the cursor with lag"></canvas></div>
            )}
            {t.id === 'ash' && (
              <div class="tile-live tile-ash">
                <p class="tile-hint">In Perennial, Space on an empty line summons Ash.</p>
                <div class="ash-editor">
                  <input class="ash-input" type="text" placeholder="Write a note, or press Space" autocomplete="off" spellcheck="false" />
                  <div class="ash-pop" hidden>
                    <button type="button" data-act="Summarize">Summarize</button>
                    <button type="button" data-act="Draft email">Draft email</button>
                    <button type="button" data-act="Extract tasks">Extract tasks</button>
                  </div>
                  <p class="ash-result" aria-live="polite"></p>
                </div>
              </div>
            )}
            {t.id === 'specimen' && (
              <div class="tile-live tile-specimen" tabindex="0" aria-label="Interactive type specimen. Move the pointer to change weight and spacing.">
                <span class="specimen-word">extras</span>
                <span class="specimen-meta"><span class="specimen-weight">400</span> · GT America</span>
              </div>
            )}
            {t.id === 'segmented' && (
              <div class="tile-live tile-segmented">
                <p class="tile-hint">The thumb travels; the labels stay still.</p>
                <div class="seg" role="tablist">
                  <span class="seg-thumb" aria-hidden="true"></span>
                  {['Day', 'Auto', 'Night'].map((o, i) => (
                    <button type="button" class="seg-opt" role="tab" aria-selected={i === 1 ? 'true' : 'false'}>{o}</button>
                  ))}
                </div>
              </div>
            )}
            {t.id === 'drift' && (
              <div class="tile-live tile-drift"><canvas class="fx-canvas" data-fx="drift" aria-label="Particles drifting slowly, leaving faint trails"></canvas></div>
            )}
            {t.id === 'toasts' && (
              <div class="tile-live tile-toasts">
                <p class="tile-hint">Enter from the bottom, leave through the bottom.</p>
                <button class="toast-btn" type="button">Save changes</button>
                <div class="toast-stack" aria-live="polite"></div>
              </div>
            )}
            {t.id === 'command' && (
              <div class="tile-live tile-command">
                <input class="cmd-input" type="text" placeholder="Type a command" autocomplete="off" spellcheck="false" aria-label="Filter commands" />
                <ul class="cmd-list">
                  {['Create invoice', 'Log time', 'New project', 'Add contact', 'Open calendar', 'Search notes'].map((c) => (
                    <li class="cmd-row">{c}</li>
                  ))}
                </ul>
                <p class="tile-hint cmd-hint">Keyboard first. Zero animation on purpose.</p>
              </div>
            )}
            {t.id === 'clock' && (
              <div class="tile-live tile-clock">
                <svg class="clock-svg" viewBox="0 0 200 200" aria-label="The current time as three rings">
                  <circle class="ring ring-h" cx="100" cy="100" r="80" />
                  <circle class="ring ring-m" cx="100" cy="100" r="62" />
                  <circle class="ring ring-s" cx="100" cy="100" r="44" />
                </svg>
                <span class="clock-label"></span>
              </div>
            )}
            {t.id === 'slider' && (
              <div class="tile-live tile-slider">
                <p class="tile-hint">The track bends under tension and springs back.</p>
                <svg class="slider-svg" viewBox="0 0 320 80">
                  <path class="slider-track" d="M 16 40 L 304 40" />
                  <circle class="slider-thumb" cx="160" cy="40" r="9" />
                </svg>
                <span class="slider-value">50</span>
              </div>
            )}
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="static" class="gallery-section">
      <h2 class="section-label">Static</h2>
      <div class="tile-grid">
        {STATIC_TILES.map((t, i) => (
          <figure class="tile">
            <img src={t.src} alt={t.title} loading={i < 3 ? 'eager' : 'lazy'} />
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="physical" class="gallery-section">
      <h2 class="section-label">Physical</h2>
      <div class="tile-grid">
        {PHYSICAL_TILES.map((t) => (
          <figure class="tile">
            <img src={t.src} alt={t.title} loading="lazy" />
            <figcaption><span class="tile-title">{t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .crumb { position: fixed; top: 34px; left: 40px; z-index: 10; font-size: 15px; }
  .crumb a { text-decoration: none; color: var(--mid); transition: color 150ms ease; }
  @media (hover: hover) and (pointer: fine) { .crumb a:hover { color: var(--ink); } }
  .crumb-sep { color: var(--faint); margin: 0 4px; }
  .crumb-here { color: var(--faint); }

  .side-nav {
    position: fixed;
    top: 200px;
    left: 32px;
    max-width: 150px;
    font-size: 15px;
    transition: opacity 200ms ease, visibility 200ms;
  }
  @media (max-width: 1119px) { .side-nav { opacity: 0; visibility: hidden; } }
  .side-nav ul { margin: 0; padding: 0; list-style: none; }
  .side-nav li { margin-bottom: 10px; }
  .side-nav a { position: relative; color: var(--faint); text-decoration: none; transition: color 150ms ease; }
  .side-nav a::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .side-nav a:hover { color: var(--mid); } }
  .side-nav a.active { color: var(--ink); }
  .side-nav a.active::before { opacity: 1; }

  .gallery-page {
    max-width: 1360px;
    margin-inline: auto;
    padding: 150px var(--pad-x) 120px;
  }

  .gallery-section { margin-bottom: 96px; animation: rise 400ms var(--ease-out) backwards; }
  .gallery-section:last-child { margin-bottom: 0; }
  .section-label {
    margin: 0 0 28px calc(-1 * var(--outdent));
    font-size: inherit;
    font-weight: 400;
    color: var(--faint);
  }

  .tile-grid { columns: 3 340px; column-gap: 24px; }
  .tile { break-inside: avoid; margin: 0 0 40px; }
  .tile img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    display: block;
  }
  .tile figcaption { margin-top: 10px; font-size: 13px; color: var(--mid); }

  .tile-live {
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    overflow: hidden;
    position: relative;
    padding: 24px;
  }
  .tile-hint { margin: 0 0 18px; font-size: 13px; color: var(--mid); max-width: 34ch; }

  .tile-field, .tile-chain, .tile-drift { height: 340px; padding: 0; }
  .fx-canvas { width: 100%; height: 100%; display: block; }

  /* Hold to confirm */
  .hold-btn {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    padding: 10px 22px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .hold-fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 200ms var(--ease-out);
  }
  .hold-btn.holding .hold-fill { clip-path: inset(0 0 0 0); transition: clip-path 1100ms linear; }
  .hold-text { position: relative; z-index: 1; transition: color 150ms ease; }
  .hold-btn.holding .hold-text, .hold-btn.confirmed .hold-text { color: var(--bg); }
  .hold-btn.confirmed .hold-fill { clip-path: inset(0 0 0 0); }

  /* Palette */
  .palette-input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--faint);
    background: none;
    font: inherit;
    font-size: 22px;
    font-weight: 500;
    color: var(--ink);
    padding: 4px 0 8px;
    outline: none;
  }
  .palette-input:focus { border-bottom-color: var(--ink); }
  .palette-chip { display: flex; align-items: center; gap: 12px; margin-top: 22px; }
  .palette-swatch { width: 44px; height: 44px; border-radius: 10px; background: #537f48; transition: background-color 300ms var(--ease-out); }
  .palette-name { font-size: 14px; color: var(--mid); font-variant-numeric: tabular-nums; }

  /* Tasks that linger */
  .linger-list { margin: 0; padding: 0; list-style: none; }
  .linger-item {
    display: flex;
    align-items: center;
    gap: 12px;
    max-height: 44px;
    overflow: hidden;
    transition: max-height 300ms var(--ease-out), opacity 300ms ease;
    padding: 8px 0;
  }
  .linger-item.gone { max-height: 0; opacity: 0; padding-block: 0; }
  .linger-check {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    border: 1.5px solid var(--mid);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .linger-item.done .linger-check { background: var(--ink); border-color: var(--ink); }
  .linger-item.done .linger-check::after { content: ''; width: 5px; height: 8px; border: solid var(--bg); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg) translateY(-1px); }
  .linger-text { font-size: 15px; color: var(--ink); transition: color 200ms ease; }
  .linger-item.done .linger-text { color: var(--faint); text-decoration: line-through; }
  .linger-reset { margin-top: 10px; border: 0; background: none; font: inherit; font-size: 13px; color: var(--faint); cursor: pointer; padding: 0; }
  .linger-reset:hover { color: var(--mid); }

  /* Space for Ash */
  .ash-editor { position: relative; }
  .ash-input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--faint);
    background: none;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    padding: 4px 0 8px;
    outline: none;
  }
  .ash-input:focus { border-bottom-color: var(--ink); }
  .ash-pop {
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 6px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
    z-index: 2;
  }
  .ash-pop button {
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    text-align: left;
    padding: 7px 12px;
    border-radius: 6px;
    cursor: pointer;
  }
  .ash-pop button:hover { background: var(--surface); }
  .ash-result { margin: 12px 0 0; font-size: 13px; color: var(--mid); min-height: 18px; }

  /* Specimen */
  .tile-specimen { height: 300px; display: grid; place-items: center; cursor: crosshair; user-select: none; padding: 0; }
  .specimen-word { font-size: 72px; font-weight: 400; color: var(--ink); letter-spacing: 0; line-height: 1; }
  .specimen-meta { position: absolute; left: 20px; bottom: 16px; font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums; }

  /* Segmented */
  .seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 3px;
  }
  .seg-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px) / 3);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    transform: translateX(100%);
    transition: transform 250ms var(--ease-out);
  }
  .seg-opt {
    position: relative;
    z-index: 1;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--mid);
    padding: 7px 0;
    cursor: pointer;
    transition: color 150ms ease;
  }
  .seg-opt[aria-selected='true'] { color: var(--ink); }

  /* Toasts */
  .tile-toasts { height: 260px; }
  .toast-btn {
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--bg);
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    padding: 8px 16px;
    cursor: pointer;
    transition: transform 150ms var(--ease-out);
  }
  .toast-btn:active { transform: scale(0.97); }
  .toast-stack {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
  }
  .toast {
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    border-radius: 8px;
    padding: 9px 14px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 250ms var(--ease-out), transform 250ms var(--ease-out);
  }
  .toast.on { opacity: 1; transform: translateY(0); }

  /* Command */
  .cmd-input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--faint);
    background: none;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    padding: 4px 0 8px;
    margin-bottom: 10px;
    outline: none;
  }
  .cmd-input:focus { border-bottom-color: var(--ink); }
  .cmd-list { margin: 0; padding: 0; list-style: none; }
  .cmd-row { font-size: 14px; color: var(--ink); padding: 7px 10px; border-radius: 6px; }
  .cmd-row.active { background: var(--bg); }
  .cmd-row[hidden] { display: none; }
  .cmd-hint { margin: 12px 0 0; }

  /* Clock */
  .tile-clock { height: 300px; display: grid; place-items: center; padding: 0; }
  .ring { fill: none; stroke-linecap: round; transform: rotate(-90deg); transform-origin: center; }
  .ring-h { stroke: var(--ink); stroke-width: 3; }
  .ring-m { stroke: var(--mid); stroke-width: 2.5; }
  .ring-s { stroke: var(--faint); stroke-width: 2; }
  .clock-label { position: absolute; left: 20px; bottom: 16px; font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums; }

  /* Elastic slider */
  .slider-svg { width: 100%; height: 80px; display: block; touch-action: none; }
  .slider-track { fill: none; stroke: var(--faint); stroke-width: 2; stroke-linecap: round; }
  .slider-thumb { fill: var(--ink); cursor: grab; }
  .slider-value { position: absolute; right: 20px; bottom: 16px; font-size: 12px; color: var(--faint); font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    .gallery-page { padding-top: 110px; }
    .tile-grid { columns: 1; }
  }
</style>

<script>
  // ── Scrollspy (same behavior as piece pages).
  {
    const nav = document.querySelector('.side-nav');
    if (nav) {
      const links = [...nav.querySelectorAll('a')] as HTMLAnchorElement[];
      const byId = new Map(links.map((a) => [a.hash.slice(1), a] as const));
      const setActive = (id: string) => links.forEach((a) => a.classList.toggle('active', a === byId.get(id)));
      const spy = new IntersectionObserver(
        (es) => {
          const vis = es.filter((e) => e.isIntersecting);
          if (vis.length > 0) setActive(vis[0].target.id);
        },
        { rootMargin: '-10% 0px -80% 0px' }
      );
      byId.forEach((_, id) => { const el = document.getElementById(id); if (el) spy.observe(el); });
      setActive('interactive');
    }
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Canvas helper: sized, dpr-aware, running only while on screen.
  function canvasFx(el: HTMLCanvasElement, draw: (ctx: CanvasRenderingContext2D, w: number, h: number, t: number) => void, animated: boolean) {
    const ctx = el.getContext('2d')!;
    let w = 0, h = 0, raf: number | null = null, visible = false;
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = el.clientWidth; h = el.clientHeight;
      el.width = w * dpr; el.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(ctx, w, h, performance.now());
    };
    const loop = (t: number) => { draw(ctx, w, h, t); raf = visible ? requestAnimationFrame(loop) : null; };
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (visible) { resize(); if (animated && !reduce && raf === null) raf = requestAnimationFrame(loop); }
      else if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
    }).observe(el);
    addEventListener('resize', () => { if (visible) resize(); });
    resize();
    return { start: () => { if (!reduce && raf === null && visible) raf = requestAnimationFrame(loop); }, ctx: () => ctx, redraw: () => draw(ctx, w, h, performance.now()) };
  }
  const tokens = () => {
    const cs = getComputedStyle(document.documentElement);
    return { faint: cs.getPropertyValue('--faint').trim(), mid: cs.getPropertyValue('--mid').trim(), ink: cs.getPropertyValue('--ink').trim() };
  };

  // ── Field
  {
    const el = document.querySelector<HTMLCanvasElement>('[data-fx="field"]');
    if (el) {
      let mx = -9999, my = -9999;
      const GAP = 26;
      const fx = canvasFx(el, (ctx, w, h) => {
        const { faint, ink } = tokens();
        ctx.clearRect(0, 0, w, h);
        for (let x = GAP / 2; x < w; x += GAP) for (let y = GAP / 2; y < h; y += GAP) {
          const dx = mx - x, dy = my - y, d = Math.hypot(dx, dy);
          const pull = Math.max(0, 1 - d / 150);
          const ox = d > 0 ? (dx / d) * pull * 7 : 0, oy = d > 0 ? (dy / d) * pull * 7 : 0;
          ctx.fillStyle = pull > 0.02 ? ink : faint;
          ctx.globalAlpha = 0.35 + pull * 0.65;
          ctx.beginPath(); ctx.arc(x + ox, y + oy, 1.5 + pull * 1.2, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }, false);
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(); mx = e.clientX - r.left; my = e.clientY - r.top; fx.redraw();
      });
      el.addEventListener('pointerleave', () => { mx = -9999; my = -9999; fx.redraw(); });
    }
  }

  // ── Chain: segments ease toward the one before them.
  {
    const el = document.querySelector<HTMLCanvasElement>('[data-fx="chain"]');
    if (el) {
      const N = 14;
      const pts = Array.from({ length: N }, () => ({ x: 100, y: 100 }));
      let tx = 160, ty = 160;
      canvasFx(el, (ctx, w, h) => {
        const { ink, faint } = tokens();
        pts[0].x += (tx - pts[0].x) * 0.22; pts[0].y += (ty - pts[0].y) * 0.22;
        for (let i = 1; i < N; i++) {
          pts[i].x += (pts[i - 1].x - pts[i].x) * 0.22;
          pts[i].y += (pts[i - 1].y - pts[i].y) * 0.22;
        }
        ctx.clearRect(0, 0, w, h);
        ctx.strokeStyle = faint; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < N; i++) ctx.lineTo(pts[i].x, pts[i].y);
        ctx.stroke();
        for (let i = 0; i < N; i++) {
          ctx.fillStyle = ink;
          ctx.globalAlpha = 1 - (i / N) * 0.8;
          ctx.beginPath(); ctx.arc(pts[i].x, pts[i].y, 4 - (i / N) * 2.5, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }, true);
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(); tx = e.clientX - r.left; ty = e.clientY - r.top;
      });
    }
  }

  // ── Drift: slow particles with faint trails.
  {
    const el = document.querySelector<HTMLCanvasElement>('[data-fx="drift"]');
    if (el) {
      type P = { x: number; y: number; a: number };
      let ps: P[] = [];
      let seeded = false;
      canvasFx(el, (ctx, w, h) => {
        const { mid } = tokens();
        if (!seeded) {
          ps = Array.from({ length: 50 }, () => ({ x: Math.random() * w, y: Math.random() * h, a: Math.random() * Math.PI * 2 }));
          seeded = true;
          ctx.clearRect(0, 0, w, h);
        }
        ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--surface').trim();
        ctx.globalAlpha = 0.16;
        ctx.fillRect(0, 0, w, h);
        ctx.globalAlpha = 0.8;
        ctx.fillStyle = mid;
        for (const p of ps) {
          p.a += (Math.random() - 0.5) * 0.25;
          p.x += Math.cos(p.a) * 0.7; p.y += Math.sin(p.a) * 0.7;
          if (p.x < 0) p.x = w; if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h; if (p.y > h) p.y = 0;
          ctx.beginPath(); ctx.arc(p.x, p.y, 1.4, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalAlpha = 1;
      }, true);
    }
  }

  // ── Hold to confirm.
  {
    const btn = document.querySelector<HTMLButtonElement>('.hold-btn');
    const text = btn?.querySelector<HTMLElement>('.hold-text');
    if (btn && text) {
      let timer: ReturnType<typeof setTimeout> | null = null;
      const arm = () => {
        if (btn.classList.contains('confirmed')) return;
        btn.classList.add('holding');
        timer = setTimeout(() => {
          btn.classList.remove('holding');
          btn.classList.add('confirmed');
          text.textContent = 'Deleted';
          setTimeout(() => { btn.classList.remove('confirmed'); text.textContent = 'Hold to delete'; }, 1600);
        }, reduce ? 300 : 1100);
      };
      const disarm = () => { btn.classList.remove('holding'); if (timer) { clearTimeout(timer); timer = null; } };
      btn.addEventListener('pointerdown', arm);
      btn.addEventListener('pointerup', disarm);
      btn.addEventListener('pointerleave', disarm);
    }
  }

  // ── Every word has a color.
  {
    const PALETTE: [string, string][] = [
      ['Green', '#90c84a'], ['Grey', '#b5b5b6'], ['Brown', '#8b5d51'], ['Orange', '#e78625'],
      ['Yellow', '#e8c547'], ['Olive', '#537f48'], ['Blue', '#2564ab'], ['Purple', '#6d50a1'],
      ['Rose', '#dc5270'], ['Red', '#da4126'],
    ];
    const inp = document.querySelector<HTMLInputElement>('.palette-input');
    const sw = document.querySelector<HTMLElement>('.palette-swatch');
    const nm = document.querySelector<HTMLElement>('.palette-name');
    const paint = () => {
      if (!inp || !sw || !nm) return;
      const wd = inp.value.trim().toLowerCase();
      if (!wd) { nm.textContent = ''; return; }
      let hsh = 5381;
      for (let i = 0; i < wd.length; i++) hsh = ((hsh << 5) + hsh + wd.charCodeAt(i)) >>> 0;
      const [name, hex] = PALETTE[hsh % PALETTE.length];
      sw.style.backgroundColor = hex;
      nm.textContent = `${name} ${hex}`;
    };
    inp?.addEventListener('input', paint);
    paint();
  }

  // ── Tasks that linger (650ms, like Perennial's task list).
  {
    const items = [...document.querySelectorAll<HTMLElement>('.linger-item')];
    items.forEach((item) => {
      item.querySelector('.linger-check')?.addEventListener('click', () => {
        if (item.classList.contains('done')) return;
        item.classList.add('done');
        setTimeout(() => item.classList.add('gone'), 650);
      });
    });
    document.querySelector('.linger-reset')?.addEventListener('click', () => {
      items.forEach((i) => i.classList.remove('done', 'gone'));
    });
  }

  // ── Space for Ash.
  {
    const input = document.querySelector<HTMLInputElement>('.ash-input');
    const pop = document.querySelector<HTMLElement>('.ash-pop');
    const result = document.querySelector<HTMLElement>('.ash-result');
    if (input && pop && result) {
      input.addEventListener('keydown', (e) => {
        if (e.key === ' ' && input.value === '') { e.preventDefault(); pop.hidden = false; }
        if (e.key === 'Escape') pop.hidden = true;
      });
      input.addEventListener('input', () => { pop.hidden = true; });
      pop.querySelectorAll('button').forEach((b) => {
        b.addEventListener('click', () => {
          pop.hidden = true;
          result.textContent = `${b.dataset.act} → done. View →`;
          setTimeout(() => { result.textContent = ''; }, 2400);
        });
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.ash-editor')) pop.hidden = true;
      });
    }
  }

  // ── Specimen.
  {
    const spec = document.querySelector<HTMLElement>('.tile-specimen');
    const word = document.querySelector<HTMLElement>('.specimen-word');
    const label = document.querySelector<HTMLElement>('.specimen-weight');
    const WEIGHTS = [300, 400, 500, 600];
    if (spec && word && label) {
      spec.addEventListener('pointermove', (e) => {
        const r = spec.getBoundingClientRect();
        const fx = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 0.999);
        const fy = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
        const wt = WEIGHTS[Math.floor(fx * WEIGHTS.length)];
        word.style.fontWeight = String(wt);
        word.style.letterSpacing = `${((fy - 0.5) * 0.12).toFixed(3)}em`;
        label.textContent = String(wt);
      });
      spec.addEventListener('click', () => {
        const cur = Number(word.style.fontWeight || 400);
        const next = WEIGHTS[(WEIGHTS.indexOf(cur) + 1) % WEIGHTS.length];
        word.style.fontWeight = String(next);
        label.textContent = String(next);
      });
    }
  }

  // ── Segmented control.
  {
    const seg = document.querySelector<HTMLElement>('.seg');
    const thumb = seg?.querySelector<HTMLElement>('.seg-thumb');
    const opts = seg ? [...seg.querySelectorAll<HTMLButtonElement>('.seg-opt')] : [];
    if (thumb && opts.length) {
      opts.forEach((o, i) => o.addEventListener('click', () => {
        opts.forEach((x) => x.setAttribute('aria-selected', String(x === o)));
        thumb.style.transform = `translateX(${i * 100}%)`;
      }));
    }
  }

  // ── Toasts.
  {
    const btn = document.querySelector<HTMLElement>('.toast-btn');
    const stack = document.querySelector<HTMLElement>('.toast-stack');
    let n = 0;
    btn?.addEventListener('click', () => {
      n += 1;
      const t = document.createElement('div');
      t.className = 'toast';
      t.textContent = n === 1 ? 'Changes saved' : `Changes saved (${n})`;
      stack!.appendChild(t);
      requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add('on')));
      setTimeout(() => {
        t.classList.remove('on');
        t.addEventListener('transitionend', () => t.remove(), { once: true });
      }, 2200);
    });
  }

  // ── Command fragment: instant, keyboard-first.
  {
    const input = document.querySelector<HTMLInputElement>('.cmd-input');
    const rows = [...document.querySelectorAll<HTMLElement>('.cmd-row')];
    if (input && rows.length) {
      let idx = 0;
      const visible = () => rows.filter((r) => !r.hidden);
      const paint = () => {
        const v = visible();
        rows.forEach((r) => r.classList.remove('active'));
        if (v.length) { idx = Math.min(idx, v.length - 1); v[idx].classList.add('active'); }
      };
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        rows.forEach((r) => { r.hidden = q !== '' && !r.textContent!.toLowerCase().includes(q); });
        idx = 0; paint();
      });
      input.addEventListener('keydown', (e) => {
        const v = visible();
        if (e.key === 'ArrowDown') { e.preventDefault(); idx = Math.min(idx + 1, v.length - 1); paint(); }
        if (e.key === 'ArrowUp') { e.preventDefault(); idx = Math.max(idx - 1, 0); paint(); }
      });
      paint();
    }
  }

  // ── Clock: three rings for hours, minutes, seconds.
  {
    const svg = document.querySelector<SVGElement>('.clock-svg');
    const label = document.querySelector<HTMLElement>('.clock-label');
    if (svg && label) {
      const rings = {
        h: svg.querySelector<SVGCircleElement>('.ring-h')!,
        m: svg.querySelector<SVGCircleElement>('.ring-m')!,
        s: svg.querySelector<SVGCircleElement>('.ring-s')!,
      };
      const setRing = (c: SVGCircleElement, frac: number) => {
        const r = Number(c.getAttribute('r'));
        const circ = 2 * Math.PI * r;
        c.style.strokeDasharray = `${circ}`;
        c.style.strokeDashoffset = `${circ * (1 - Math.max(frac, 0.002))}`;
      };
      const update = () => {
        const d = new Date();
        setRing(rings.h, (d.getHours() % 12) / 12 + d.getMinutes() / 60 / 12);
        setRing(rings.m, d.getMinutes() / 60 + d.getSeconds() / 3600);
        setRing(rings.s, d.getSeconds() / 60);
        label.textContent = d.toTimeString().slice(0, 8);
      };
      update();
      setInterval(update, 1000);
    }
  }

  // ── Elastic slider.
  {
    const svg = document.querySelector<SVGSVGElement>('.slider-svg');
    const track = document.querySelector<SVGPathElement>('.slider-track');
    const thumb = document.querySelector<SVGCircleElement>('.slider-thumb');
    const out = document.querySelector<HTMLElement>('.slider-value');
    if (svg && track && thumb && out) {
      const X0 = 16, X1 = 304, CY = 40;
      let x = 160, bend = 0, dragging = false, raf: number | null = null, vel = 0;
      const paint = () => {
        track.setAttribute('d', `M ${X0} ${CY} Q ${x} ${CY + bend} ${X1} ${CY}`);
        thumb.setAttribute('cx', String(x));
        thumb.setAttribute('cy', String(CY + bend / 2));
        out.textContent = String(Math.round(((x - X0) / (X1 - X0)) * 100));
      };
      const settle = () => {
        vel += -bend * 0.18;
        vel *= 0.82;
        bend += vel;
        paint();
        if (Math.abs(bend) > 0.3 || Math.abs(vel) > 0.3) raf = requestAnimationFrame(settle);
        else { bend = 0; vel = 0; paint(); raf = null; }
      };
      const toLocal = (e: PointerEvent) => {
        const r = svg.getBoundingClientRect();
        return { x: ((e.clientX - r.left) / r.width) * 320, y: ((e.clientY - r.top) / r.height) * 80 };
      };
      thumb.addEventListener('pointerdown', (e) => { dragging = true; thumb.setPointerCapture(e.pointerId); if (raf) { cancelAnimationFrame(raf); raf = null; } });
      thumb.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const p = toLocal(e);
        x = Math.min(Math.max(p.x, X0), X1);
        bend = reduce ? 0 : Math.min(Math.max(p.y - CY, -26), 26);
        paint();
      });
      const release = () => { if (!dragging) return; dragging = false; if (reduce) { bend = 0; paint(); } else if (raf === null) raf = requestAnimationFrame(settle); };
      thumb.addEventListener('pointerup', release);
      thumb.addEventListener('pointercancel', release);
      paint();
    }
  }
</script>
