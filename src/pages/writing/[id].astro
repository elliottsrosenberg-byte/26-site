---
import { getCollection, render } from 'astro:content';
import Piece from '../../layouts/Piece.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !(import.meta.env.PROD && data.draft));
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Piece title={entry.data.title} description={entry.data.description} headings={headings} transitionName={`title-writing-${entry.id}`}>
  <Content />
</Piece>
